#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Ekraninė klaviatūra"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Išjungta"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Prilietimai ir planšetė"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Prilietimai, planšetė, pelė ir jutiklinis kilimėlis"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Konfigūruoti ekranines klaviatūras…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Ekraninė klaviatūra: neprieinama\n"
"Spustelėkite ar bakstelėkite norėdami konfigūruoti jos nuostatas"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Sukonfigūruota, kad nebūtų automatiškai rodoma\n"
"Spustelėkite ar bakstelėkite norėdami konfigūruoti ekraninės klaviatūros "
"nuostatas"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Šiuo metu nėra aktyvus joks palaikomas įvesties laukas\n"
"Spustelėkite ar bakstelėkite norėdami rodyti fizinės klaviatūros emuliavimo "
"veiksenoje."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Ekraninė klaviatūra yra matoma\n"
"Spustelėkite ar bakstelėkite norėdami ją paslėpti."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Rodoma automatiškai, kai bakstelėjama ant įvesties lauko\n"
"Bakstelėkite norėdami konfigūruoti ekraninės klaviatūros nuostatas"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Rodoma automatiškai, kai sąveikaujama su įvesties lauku\n"
"Spustelėkite ar bakstelėkite norėdami konfigūruoti ekraninės klaviatūros "
"nuostatas"

