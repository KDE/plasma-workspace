#~ msgstr "Virtuali klaviatūra: neprieinama"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtuali klaviatūra: išjungta"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Rodyti virtualią klaviatūrą"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtuali klaviatūra: matoma"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtuali klaviatūra: Rodyti esant ne pelės įvedimui"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtuali klaviatūra: Rodyti su visais įvedimo įrenginiais"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtuali klaviatūra: įjungta"
