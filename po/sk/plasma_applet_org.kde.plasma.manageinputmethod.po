#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Klávesnica na obrazovke"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Zakázané"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dotyk a tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dotyk, tablet, myš a touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Nastaviť klávesnice na obrazovke…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Klávesnica na obrazovke: nedostupná\n"
"Kliknutím alebo ťuknutím nastavíte klávesnicu na obrazovke"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Nastavené tak, aby sa nezobrazovala automaticky\n"
"Kliknutím alebo ťuknutím nastavíte klávesnicu na obrazovke"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Momentálne nie je aktívne žiadne podporované textové pole\n"
"Kliknutím alebo ťuknutím ju zobrazíte v režime emulácie hardvérovej "
"klávesnice."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Klávesnica na obrazovke je viditeľná\n"
"Kliknutím alebo ťuknutím klávesnicu na obrazovke skryjete."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Zobrazí sa automaticky po ťuknutí na textové pole\n"
"Ťuknutím nastavíte klávesnicu na obrazovke"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Zobrazí sa automaticky pri práci s textovým poľom\n"
"Kliknutím alebo ťuknutím nastavíte klávesnicu na obrazovke"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Virtuálna klávesnica: nedostupná"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtuálna klávesnica: zakázaná"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Zobraziť virtuálnu klávesnicu"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtuálna klávesnica: viditeľná"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtuálna klávesnica: zobraziť pri vstupe iným než myšou"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtuálna klávesnica: zobraziť so všetkými vstupnými zariadeniami"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtuálna klávesnica: povolená"
