#: logout.cpp:260
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "„%1“ прекину одјављивање"

#: logout.cpp:354
#, kde-format
msgctxt "@info:status"
msgid "Session is exiting"
msgstr "Сесија се напушта"

#: main.cpp:69 main.cpp:77
#, kde-format
msgid "No write access to '%1'."
msgstr "Нема приступа за писање над „%1“."

#: main.cpp:71 main.cpp:79
#, kde-format
msgid "No read access to '%1'."
msgstr "Нема приступа за читање над „%1“."

#: main.cpp:84
#, kde-format
msgid ""
"The following installation problem was detected\n"
"while trying to start Plasma:"
msgstr ""
"Откривен је следећи проблем са инсталацијом\n"
"при покретању Плазме:"

#: main.cpp:87
#, kde-format
msgid ""
"\n"
"\n"
"Plasma is unable to start.\n"
msgstr ""
"\n"
"\n"
"Плазма не може да се покрене.\n"

#: main.cpp:111
#, kde-format
msgid ""
"The reliable Plasma session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Поуздан менаџер сесија Плазме који комуницира стандардним\n"
"Иксовим протоколом за управљање сесијама (ИксСМП)."

#: main.cpp:115
#, kde-format
msgid "Restores the saved user session if available"
msgstr "Обнавља сачувану корисничку сесију (ако постоји)."

#: main.cpp:118
#, kde-format
msgid "Also allow remote connections"
msgstr "Такође дозволи удаљене везе"

#: server.cpp:764
#, kde-format
msgctxt "@label an unknown executable is using resources"
msgid "[unknown]"
msgstr "[непознато]"

#: server.cpp:787
#, kde-kuit-format
msgctxt "@label notification; %1 is a list of executables"
msgid ""
"Unable to manage some apps because the system's session management resources "
"are exhausted. Here are the top three consumers of session resources:\n"
"%1"
msgstr ""
"Не могу да управљам неким програмима јер су системски ресурси за управљање "
"сесијама исцрпљени. Ево три највећа потрошача ресурса сесије:\n"
"%1"

#: server.cpp:1042
#, kde-kuit-format
msgctxt "@label notification; %1 is an executable name"
msgid ""
"Unable to restore <application>%1</application> because it is broken and has "
"exhausted the system's session restoration resources. Please report this to "
"the app's developers."
msgstr ""
"Не могу да обновим <application>%1</application> јер је програм покварен и "
"исцрпео је системске ресурсе за обнављање сесије. Пријавите ово његовим "
"програмерима."
