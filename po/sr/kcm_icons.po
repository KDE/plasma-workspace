#. i18n: ectx: label, entry (Theme), group (Icons)
#: iconssettingsbase.kcfg:9
#, kde-format
msgid "Name of the current icon theme"
msgstr "Име текуће теме иконица"

#: main.cpp:147
#, kde-format
msgid "Unable to create a temporary file."
msgstr "Не могу да направим привремени фајл."

#: main.cpp:158
#, kde-format
msgid "Unable to download the icon theme archive: %1"
msgstr "Не могу да преузмем архиву теме иконица: %1"

#: main.cpp:172
#, kde-format
msgid "The file is not a valid icon theme archive."
msgstr "Овај фајл није исправна архива теме иконица."

#: main.cpp:177
#, kde-format
msgid ""
"A problem occurred during the installation process; however, most of the "
"themes in the archive have been installed"
msgstr ""
"Дошло је до проблема у току инсталације. Ипак, већи део тема из архиве је "
"инсталиран."

#: main.cpp:181
#, kde-format
msgid "Theme installed successfully."
msgstr "Тема успешно инсталирана."

# >> @title:window
#: main.cpp:227
#, kde-format
msgid "Installing icon themes…"
msgstr "Инсталирам теме иконица…"

# >> @title:window
#: main.cpp:239
#, kde-format
msgid "Installing %1 theme…"
msgstr "Инсталирам тему %1…"

#: ui/main.qml:67
#, kde-format
msgid "Install from File…"
msgstr "Инсталирај из фајла…"

#: ui/main.qml:72
#, kde-format
msgid "Get New…"
msgstr "Добави нове…"

#: ui/main.qml:189
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove icon theme"
msgstr "Уклони тему иконица"

#: ui/main.qml:191
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active icon theme"
msgstr "Не могу да обришем активну тему иконица"

#: ui/main.qml:193
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed icon themes"
msgstr "Не могу да обришем системски инсталиране теме иконица"

#: ui/main.qml:201
#, kde-format
msgctxt "@info:tooltip"
msgid "Don’t delete this icon theme"
msgstr "Не бриши ову тему иконица"

#: ui/main.qml:250
#, kde-format
msgid "Open Theme"
msgstr "Отварање теме"

#: ui/main.qml:252
#, kde-format
msgid "Theme Files (*.tar.gz *.tar.bz2)"
msgstr "фајлови тема (*.tar.gz *.tar.bz2)"
