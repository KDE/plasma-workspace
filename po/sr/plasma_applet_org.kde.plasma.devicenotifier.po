#: actions/checkaction.cpp:71
#, kde-format
msgctxt "@action:button check a storageAccess (i.e disk) for error"
msgid "Check for Errors"
msgstr "Провери има ли грешака"

#: actions/mountaction.cpp:93
#, kde-format
msgid "Mount"
msgstr "Монтирај"

#: actions/mountandopenaction.cpp:177
#, kde-format
msgid "Open in File Manager"
msgstr "Отвори у менаџеру фајлова"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Try to Fix"
msgstr "Покушај да поправиш"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Mount and Open"
msgstr "Монтирај и отвори"

#: actions/mountandopenaction.cpp:182
#, kde-format
msgid "Eject"
msgstr "Избаци"

#: actions/mountandopenaction.cpp:184
#, kde-format
msgid "Safely remove"
msgstr "Безбедно уклони"

#: messageinfo.cpp:108
#, kde-format
msgid "This device has file system errors."
msgstr "Овај уређај има грешке у фајл систему."

#: messageinfo.cpp:110
#, kde-format
msgctxt "@label device is a storage disk"
msgid "This device has no errors"
msgstr "Овај уређај нема грешака"

#: messageinfo.cpp:113
#, kde-format
msgid "Successfully repaired!"
msgstr "Успешно поправљено!"

#: messageinfo.cpp:117
#, kde-format
msgid "Device Status"
msgstr "Стање уређаја"

#: messageinfo.cpp:118
#, kde-format
msgid "A device can now be safely removed"
msgstr "Уређај сада можете безбедно уклонити"

#: messageinfo.cpp:122
#, kde-format
msgid "This device can now be safely removed."
msgstr "Овај уређај сада можете безбедно уклонити."

#: messageinfo.cpp:129
#, kde-format
msgid "You are not authorized to mount this device."
msgstr "Нисте овлашћени да монтирате овај уређај."

#: messageinfo.cpp:133
#, kde-format
msgid "You are not authorized to eject this disc."
msgstr "Нисте овлашћени да избаците овај диск."

#: messageinfo.cpp:136
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "You are not authorized to remove this device."
msgstr "Нисте овлашћени да уклоните овај уређај."

#: messageinfo.cpp:139
#, kde-format
msgid "You are not authorized to repair this device."
msgstr "Нисте овлашћени да поправите овај уређај."

#: messageinfo.cpp:141 messageinfo.cpp:208
#, kde-format
msgid "Unknown error type"
msgstr "Непозната врста грешке"

#: messageinfo.cpp:145
#, kde-format
msgid "Could not mount this device as it is busy."
msgstr "Не могу да монтирам овај уређај јер је заузет."

#: messageinfo.cpp:173
#, kde-format
msgid "One or more files on this device are open within an application."
msgstr "Један или више фајлова на овом уређају отворени су у неком програму."

#: messageinfo.cpp:175
#, kde-format
msgid "One or more files on this device are opened in application \"%2\"."
msgid_plural ""
"One or more files on this device are opened in following applications: %2."
msgstr[0] ""
"Један или више фајлова на овом уређају отворени су у следећим програмима: %2."
msgstr[1] ""
"Један или више фајлова на овом уређају отворени су у следећим програмима: %2."
msgstr[2] ""
"Један или више фајлова на овом уређају отворени су у следећим програмима: %2."
msgstr[3] "Један или више фајлова на овом уређају отворени су у програму „%2“."

#: messageinfo.cpp:178
#, kde-format
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr ", "

#: messageinfo.cpp:197
#, kde-format
msgid "Could not mount this device."
msgstr "Не могу да монтирам овај уређај."

#: messageinfo.cpp:201
#, kde-format
msgid "Could not eject this disc."
msgstr "Не могу да избацим овај диск."

#: messageinfo.cpp:203
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "Could not remove this device."
msgstr "Не могу да уклоним овај уређај."

#: messageinfo.cpp:206
#, kde-format
msgid "Could not repair this device: %1"
msgstr "Не могу да поправим овај уређај: %1"

#: qml/DeviceItem.qml:98
#, kde-format
msgctxt ""
"Translation should be short and mean 'Currently checking the device for "
"filesystem errors'"
msgid "Checking…"
msgstr "Проверавам…"

#: qml/DeviceItem.qml:100
#, kde-format
msgctxt ""
"Translation should be short and mean 'The storage device contains filesystem "
"errors and is being repaired'"
msgid "Repairing…"
msgstr "Поправљам…"

#: qml/DeviceItem.qml:103
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free of %2"
msgstr "%1 слободно од %2"

#: qml/DeviceItem.qml:107
#, kde-format
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing…"
msgstr "Приступам…"

#: qml/DeviceItem.qml:110
#, kde-format
msgctxt ""
"Removing is a less technical word for Unmounting; translation should be "
"short and mean 'Currently unmounting this device'"
msgid "Removing…"
msgstr "Уклањам…"

#: qml/DeviceItem.qml:113
#, kde-format
msgid "Don't unplug yet! Files are still being transferred…"
msgstr "Још не извлачите! Фајлови се и даље преносе…"

#: qml/FullRepresentation.qml:47 qml/main.qml:127
#, kde-format
msgid "Remove All"
msgstr "Уклони све"

#: qml/FullRepresentation.qml:48
#, kde-format
msgid "Click to safely remove all devices"
msgstr "Кликните да безбедно уклоните све уређаје"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No removable devices attached"
msgstr "Нема прикључених уклоњивих уређаја"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No disks available"
msgstr "Нема доступних дискова"

#: qml/main.qml:76
#, kde-format
msgid "Most Recent Device"
msgstr "Последњи уређај"

#: qml/main.qml:76
#, kde-format
msgid "No Devices Available"
msgstr "Нема доступних уређаја"

#: qml/main.qml:113
#, kde-format
msgctxt "Open auto mounter kcm"
msgid "Configure Removable Devices…"
msgstr "Подеси уклоњиве уређаје…"

#: qml/main.qml:135
#, kde-format
msgid "Removable Devices"
msgstr "Уклоњиви уређаји"

#: qml/main.qml:150
#, kde-format
msgid "Non Removable Devices"
msgstr "Неуклоњиви уређаји"

#: qml/main.qml:165
#, kde-format
msgid "All Devices"
msgstr "Сви уређаји"

#: qml/main.qml:182
#, kde-format
msgid "Show popup when new device is plugged in"
msgstr "Прикажи искакач кад се утакне нови уређај"
