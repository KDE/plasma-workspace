#: gtkpage.cpp:57
#, kde-format
msgid "%1 is not a valid GTK Theme archive."
msgstr "%1 は有効な GTK テーマアーカイブではありません。"

#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr ""
"インストールに失敗しました。リモートの場所からスタイルをインストールすること"
"はできません。"

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "インストールに失敗しました。スタイルファイルを読み込めませんでした。"

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
msgstr ""
"インストールに失敗しました。スタイルファイルにデータが含まれていません。"

#: kcmstyle.cpp:134
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be unpacked."
msgstr "インストールに失敗しました。スタイルファイルを展開できませんでした。"

#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "インストールに失敗しました。スタイルが見つかりませんでした。"

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr ""
"インストールに失敗しました。指定されたファイルは正しい Union スタイルではあり"
"ません。"

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "インストールに失敗しました。指定されたスタイルに対応していません。"

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr ""
"“%1” のインストールに失敗しました。このスタイルはすでにインストール済みです。"

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "“%1” のインストールに失敗しました。権限がありません。"

#: kcmstyle.cpp:174
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "“%1” のインストールに失敗しました。エラー内容: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "正常に “%1” をインストールしました。"

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr ""
"アンインストールに失敗しました。“%1” という ID に合致するスタイルは見つかりま"
"せんでした。"

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr "“%1” のアンインストールに失敗しました。権限がありません。"

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr ""
"“%1” のアンインストールに失敗しました。このスタイルはインストールされていませ"
"ん。"

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr "“%1” のアンインストールに失敗しました。このスタイルを使用中です。"

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "“%1” のアンインストールに失敗しました。エラー内容: %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr ""

#: kcmstyle.cpp:226
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1” but could not uninstall others:\n"
msgstr ""

#: kcmstyle.cpp:229
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style but could not uninstall others:\n"
msgid_plural ""
"Successfully uninstalled %1 styles but could not uninstall others:\n"
msgstr[0] ""

#: kcmstyle.cpp:240
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1”."
msgstr "正常に “%1” をアンインストールしました。"

#: kcmstyle.cpp:242
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style"
msgid_plural "Successfully uninstalled %1 styles."
msgstr[0] "%1 個のスタイルを正常にアンインストールしました。"

#: kcmstyle.cpp:306 kcmstyle.cpp:313
#, kde-format
msgid "There was an error loading the configuration dialog for this style."
msgstr "このスタイルの設定ダイアログの読み込み中にエラーが発生しました。"

#: kcmstyle.cpp:420
#, kde-format
msgid "Failed to apply selected style '%1'."
msgstr "選択されたスタイル '%1' の適用に失敗しました。"

