#: editactiondialog.cpp:215
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The match pattern is a regular expression. For more information see the "
"<link url=\"https://en.wikipedia.org/wiki/Regular_expression\">Wikipedia "
"entry</link> for this topic."
msgstr ""
"El patrón de coincidencia es una expresión regular. Para más información, "
"consulte la <link url=\"https://es.wikipedia.org/wiki/Expresi%C3%B3n_regular"
"\">entrada de la Wikipedia</link> sobre este tema."

