#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Tastiera su schermo"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Disabilitato"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Tocco e tavoletta grafica"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Tocco, tavoletta grafica, mouse e touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Configura le tastiere su schermo…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Tastiera su schermo: non disponibile\n"
"Fai clic o tocca per configurare le impostazioni della tastiera su schermo"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Configurato per non essere visualizzato automaticamenteFai clic o tocca per "
"configurare le impostazioni della tastiera su schermo"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Al momento non è attivo alcun campo di testo supportato.Fai clic o tocca per "
"visualizzare in modalità di emulazione della tastiera hardware."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"La tastiera su schermo è visibile\n"
"Fai clic o tocca per nascondere la tastiera su schermo."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Appare automaticamente quando si tocca un campo di testo\n"
"Tocca per configurare le impostazioni della tastiera su schermo"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Appare automaticamente quando si tocca un campo di testo\n"
"Tocca per configurare le impostazioni della tastiera su schermo"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Tastiera virtuale: non disponibile"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Tastiera virtuale: disabilitata"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Mostra la tastiera virtuale"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Tastiera virtuale: visibile"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr ""
#~ "Tastiera virtuale: mostrala quando si utilizza un dispositivo diverso dal "
#~ "mouse."

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Tastiera virtuale: mostrala con tutti i dispositivi di immissione"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Tastiera virtuale: abilitata"
