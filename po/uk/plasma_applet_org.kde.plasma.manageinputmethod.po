#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Екранна клавіатура"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Вимкнено"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Сенсорний екран і планшет"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Сенсорний екран, планшет, миша і сенсорна панель"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Налаштувати екранні клавіатури…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Екранна клавіатура: недоступна\n"
"Клацніть або натисніть для коригування параметрів екранної клавіатури"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Налаштовано вимикання автоматичного показу\n"
"Клацніть або натисніть для коригування параметрів екранної клавіатури"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Зараз не є активним підтримуване поле для введення тексту\n"
"Клацніть або натисніть, щоб показати панель у режимі імітації апаратної "
"клавіатури."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Екранна клавіатура є видимою\n"
"Клацніть або натисніть, щоб приховати екранну клавіатуру."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Налаштовано автоматичний показ при натисканні поля для введення тексту\n"
"Натисніть для коригування параметрів екранної клавіатури"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Налаштовано автоматичний показ при взаємодії з полем для введення тексту\n"
"Клацніть або натисніть для коригування параметрів екранної клавіатури"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Віртуальна клавіатура: недоступна"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Віртуальна клавіатура: вимкнено"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Показати віртуальну клавіатуру"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Віртуальна клавіатура: видима"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Віртуальна клавіатура: показувати при введенні поза мишею"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Віртуальна клавіатура: показувати для усіх пристроїв введення"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Віртуальна клавіатура: увімкнено"
