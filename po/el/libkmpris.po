#: kded/mprisservice.cpp:163
#, kde-format
msgctxt "@title shortcut"
msgid "Pause media playback"
msgstr "Παύση αναπαραγωγής πολυμέσων"

#: kded/mprisservice.cpp:164
#, kde-format
msgctxt "@title shortcut"
msgid "Play media playback"
msgstr "Αναπαραγωγή αναπαραγωγής πολυμέσων"

#: kded/mprisservice.cpp:165
#, kde-format
msgctxt "@title shortcut"
msgid "Media volume up"
msgstr "Αύξηση έντασης ήχου πολυμέσων"

#: kded/mprisservice.cpp:166
#, kde-format
msgctxt "@title shortcut"
msgid "Media volume down"
msgstr "Μείωση έντασης ήχου πολυμέσων"

