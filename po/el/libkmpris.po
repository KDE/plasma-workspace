#: kded/mprisservice.cpp:151
#, kde-format
msgctxt "@title shortcut"
msgid "Media playback seek backward 5s"
msgstr "Μετακίνηση 5 δευτερόλεπτα πίσω στην αναπαραγωγή πολυμέσων"

#: kded/mprisservice.cpp:155
#, kde-format
msgctxt "@title shortcut"
msgid "Media playback seek forward 30s"
msgstr "Μετακίνηση 30 δευτερόλεπτα μπροστά στην αναπαραγωγή πολυμέσων"

#: kded/mprisservice.cpp:159
#, kde-format
msgctxt "@title shortcut"
msgid "Media playback seek backward 30s"
msgstr "Μετακίνηση 30 δευτερόλεπτα πίσω στην αναπαραγωγή πολυμέσων"

#: kded/mprisservice.cpp:162
#, kde-format
msgctxt "@title shortcut"
