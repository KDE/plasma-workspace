#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Zaslonska tipkovnica"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Onemogočeno"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dotik in tablica"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dotik, tablica, miška in drsna ploščica"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Konfiguriraj zaslonske tipkovnice..."

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Zaslonska tipkovnica: ni na voljo\n"
"Kliknite ali dotaknite za konfiguriranje nastavitev zaslonskih tipkovnic"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Konfigurirano, da se ne prikaže samodejno\n"
"Kliknite ali dotaknite za konfiguracijo nastavitev zaslonske tipkovnice"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Trenutno ni aktivno nobeno podprto besedilno polje.\n"
"Kliknite ali dotaknite za prikaz strojne tipkovnice v načinu emulacije."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Zaslonska tipkovnica je vidna\n"
"Kliknite ali dotaknite, da skrijete zaslonsko tipkovnico."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Se prikaže samodejno ob dotiku besedilnega polja\n"
"Dotaknite za konfiguracijo nastavitev zaslonske tipkovnice"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Se prikaže Samodejno pri interakciji z besedilnim poljem\n"
"Kliknite ali dotaknite za konfiguracijo nastavitev zaslonske tipkovnice"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Virtualna tipkovnica: ni na voljo"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtualna tipkovnica: onemogočena"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Prikaži virtualno tipkovnico"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtualna tipkovnica: vidna"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtualna tipkovnica: Prikazuj pri ne-miškinem vnosu"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtualna tipkovnica: Prikazuj z vsemi vhodnimi napravami"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtualna tipkovnica: omogočena"
