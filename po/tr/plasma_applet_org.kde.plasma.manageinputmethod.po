#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Ekran Üzeri Klavye"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Devre Dışı"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dokunmatik ve Tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dokunmatik, Tablet, Fare ve Dokunmatik Yüzey"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Ekran Üzeri Klavyeleri Yapılandır…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Ekran Üzeri Klavye kullanılabilir değil\n"
"Ekran Üzeri Klavye ayarlarını yapılandırmak için tıklayın veya dokunun"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Kendiliğinden gösterilmemek üzere yapılandırılmış\n"
"Ekran Üzeri Klavye ayarlarını yapılandırmak için tıklayın veya dokunun"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Desteklenen bir metin alanı şu anda etkin değil\n"
"Donanım klavyesi öykünme kipinde göstermek için tıklayın veya dokunun"

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Ekran Üzeri Klavye şu anda görünür durumda\n"
"Ekran Üzeri Klavye’yi gizlemek için tıklayın veya dokunun"

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Bir metin alanına dokunulduğunda kendiliğinden gösterilir\n"
"Ekran Üzeri Klavye ayarlarını yapılandırmak için dokunun"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Bir metin alanıyla etkileşime girildiğinde kendiliğinden gösterilir\n"
"Ekran Üzeri Klavye ayarlarını yapılandırmak için tıklayın veya dokunun"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Sanal klavye: Kullanılamıyor"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Sanal klavye: Devre dışı"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Sanal Klavyeyi Göster"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Sanal klavye: Görünür"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Sanal klavye: Fare olmayan girişte göster"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Sanal klavye: Tüm giriş aygıtlarıyla göster"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Sanal klavye: Etkin"
