#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr "Kurulum başarısız: Uzak bir konumdan biçem kurulumu yapılamıyor."

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "Kurulum başarısız: Biçem dosyası okunamadı."

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
msgstr "Kurulum başarısız: Biçem dosyası herhangi bir veri içermiyor."

#: kcmstyle.cpp:134
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be unpacked."
msgstr "Kurulum başarısız: Biçem dosyasının paketi açılamadı."

#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "Kurulum başarısız: Biçem bulunamadı."

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr "Kurulum başarısız: Seçili dosya, geçerli bir Union biçemi değil."

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "Kurulum başarısız: Seçili biçem desteklenmiyor."

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr "“%1” kurulumu başarısız: Biçem hâlihazırda kurulu."

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "“%1” kurulumu başarısız: İzin verilmedi."

#: kcmstyle.cpp:174
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "“%1” kurulumu başarısız: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "“%1”, başarıyla kuruldu."

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr "Kurulum kaldırılamadı: “%1” kimliğine sahip biçem bulunamadı."

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr "“%1” kurulumu kaldırılamadı: İzin verilmedi."

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr "“%1” kurulumu kaldırılamadı: Biçem kurulu değil."

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr "“%1” kurulumu kaldırılamadı: Biçem kullanımda."

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "“%1” kurulumu kaldırılamadı: %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr "Biçemler kaldırılamadı:\n"

#: kcmstyle.cpp:226
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%2” but could not uninstall others:\n"
