#: gtkpage.cpp:57
#, kde-format
msgid "%1 is not a valid GTK Theme archive."
msgstr "%1 is geen geldig GTK-thema-archief."

#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr ""
"Installatie is mislukt. Een stijl installeren vanaf een locatie op afstand "
"kan niet."

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "Installatie is mislukt. Het stijlbestand kon niet worden gelezen."

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
msgstr "Installatie is mislukt. Het stijlbestand bevat geen gegevens."

#: kcmstyle.cpp:134
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be unpacked."
msgstr "Installatie is mislukt: het stijlbestand kon niet worden uitgepakt."

#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "Installatie is mislukt: De stijl is niet gevonden."

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr ""
"Installatie is mislukt: het geselecteerde bestand is geen geldige Union-"
"stijl."

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "Installatie is mislukt: de geselecteerde stijl wordt niet ondersteund."

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr "Installeren van “%1” is mislukt: de stijl is al geïnstalleerd."

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "Installeren van “%1” is mislukt: toestemming was niet gegeven."

#: kcmstyle.cpp:174
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "Installeren van “%1” is mislukt: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "“%1” met succes geïnstalleerd."

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr ""
"Installatie ongedaan maken is mislukt: de stijl met ID “%1” is niet gevonden."

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr ""
"Installatie van “%1” ongedaan maken is mislukt: toestemming was niet gegeven."

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr ""
"Installatie van “%1” ongedaan maken is mislukt: de stijl is niet "
"geïnstalleerd."

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr ""
"Installatie van “%1” ongedaan maken is mislukt: de stijl is in gebruik."

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "Installatie van “%1” ongedaan maken is mislukt: %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr "Kon de installatie van stijlen niet ongedaan maken:\n"

#: kcmstyle.cpp:226
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%2” but could not uninstall others:\n"
msgid_plural ""
"Successfully uninstalled %1 styles but could not uninstall others:\n"
msgstr[0] ""
msgstr[1] ""

#: kcmstyle.cpp:237
#, fuzzy, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%2”."
msgid_plural "Successfully uninstalled %1 styles."
msgstr[0] "Installatie van %1 met succes ongedaan gemaakt"
msgstr[1] ""

