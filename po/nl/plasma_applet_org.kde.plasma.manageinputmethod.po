#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Schermtoetsenbord"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Uitgeschakeld"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Aanraken en tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Aanraken, Tablet, Muis en Touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Schermtoetsenborden configureren…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Schermtoetsenbord: niet beschikbaar\n"
"Klik of tik om de instellingen voor het schermtoetsenbord te configureren"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Zo geconfigureerd dat deze niet automatisch wordt weergegeven\n"
"Klik of tik om de instellingen voor het schermtoetsenbord te configureren"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Er is momenteel geen ondersteund tekstveld actief\n"
"Klik of tik om de modus voor hardwaretoetsenbordemulatie weer te geven."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Schermtoetsenbord is zichtbaar\n"
"Klik of tik om het schermtoetsenbord te verbergen."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Verschijnt automatisch bij het tikken op een tekstveld\n"
"Tik om de instellingen voor het schermtoetsenbord te configureren"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Verschijnt automatisch bij interactie met een tekstveld\n"
"Klik of tik om de instellingen voor het schermtoetsenbord te configureren"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Virtueel toetsenbord: niet beschikbaar"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtueel toetsenbord: uitgeschakeld"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Virtueel toetsenbord tonen"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtueel toetsenbord: zichtbaar"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtueel toetsenbord: Tonen bij niet-muis invoer"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtueel toetsenbord: tonen met alle invoerapparaten"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtueel toetsenbord: ingeschakeld"
