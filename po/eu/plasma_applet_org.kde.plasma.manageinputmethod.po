#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Pantailako teklatua"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Ezgaituta"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Ukimena eta tableta"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Ukimena, tableta, sagua eta ukimen-sagua"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Pantailako teklatuak konfiguratu…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Pantailako teklatua: ez dago erabilgarri.\n"
"Pantailako teklatuaren ezarpenak konfiguratzeko klik egin edo tak egin."

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Automatikoki ez erakusteko konfiguratuta dago.\n"
"Pantailako teklatuaren ezarpenak konfiguratzeko klik egin edo tak egin."

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Une honetan ez dago sarrera-metodoa onartzen duen testu-eremu aktiborik.\n"
"Hardware-teklatuaren emulazio-moduan erakusteko klik egin edo tak egin."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Pantailako teklatua ikusgai dago.\n"
"Pantailako teklatua ezkutatzeko klik egin edo tak egin."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Testu-eremu batean tak egitean automatikoki erakusten da.\n"
"Pantailako teklatuaren ezarpenak konfiguratzeko tak egin."

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Testu-eremu batekin elkarreragitean automatikoki erakusten da.\n"
"Pantailako teklatuaren ezarpenak konfiguratzeko klik egin edo tak egin."

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Alegiazko teklatua: ez dago erabilgarri"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Alegiazko teklatua: ezgaituta"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Alegiazko teklatua erakutsi"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Alegiazko teklatua: ikusgai"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr ""
#~ "Alegiazko teklatua: sagua ez den sarrera-gailuarekin erabiltzean erakutsi"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Alegiazko teklatua: sarrera-gailu guztiekin erakutsi"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Alegiazko teklatua: gaituta"
