#: qml/main.qml:70
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure Virtual Keyboards..."
msgstr "Alegiazko teklatuak konfiguratu…"

#: qml/main.qml:87
#, kde-format
msgid "Virtual Keyboard: unavailable"
msgstr "Alegiazko teklatua: ez dago erabilgarri"

#: qml/main.qml:96
#, kde-format
msgid "Virtual Keyboard: disabled"
msgstr "Alegiazko teklatua: ezgaituta"

#: qml/main.qml:108
#, kde-format
msgid "Show Virtual Keyboard"
msgstr "Alegiazko teklatua erakutsi"

#: qml/main.qml:119
#, kde-format
msgid "Virtual Keyboard: visible"
msgstr "Alegiazko teklatua: ikusgai"

#: qml/main.qml:128
#, kde-format
msgid "Virtual Keyboard: Show on non-mouse input"
msgstr "Alegiazko teklatua: sagua ez den gailuarekin sarrera egitean erakutsi"

#: qml/main.qml:137
#, kde-format
msgid "Virtual Keyboard: Show with all input devices"
msgstr "Alegiazko teklatua: sarrera-gailu guztiekin erakutsi"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Alegiazko teklatua: gaituta"
