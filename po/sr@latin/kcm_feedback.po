#: ui/main.qml:28
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr ""
"Povratne informacije korisnika su centralno isključene. Obratite se svom "
"distributeru."

#: ui/main.qml:33
#, kde-format
msgid "Plasma"
msgstr "Plasma"

#: ui/main.qml:45
#, fuzzy, kde-format
#| msgctxt "@info"
#| msgid ""
#| "You can help KDE improve Plasma by contributing information on how you "
#| "use it, so we can focus on things that matter to you.<nl/><nl/"
#| ">Contributing this information is optional and entirely anonymous. We "
#| "never collect your personal data, files you use, websites you visit, or "
#| "information that could identify you.<nl/>"
msgctxt "@info"
msgid ""
"Help KDE improve Plasma by sending system and usage information. This is "
"optional and entirely anonymous—we never collect your personal data, files "
"you use, websites you visit, or information that could identify you."
msgstr ""
"Možete pomoći KDE‑u da poboljša Plasmu tako što ćete slati podatke o tome "
"kako je koristite, da bismo se usredsredili na ono što vam je važno.<nl/><nl/"
">Slanje ovih podataka je neobavezno i potpuno anonimno. Nikada ne "
"prikupljamo vaše lične podatke, fajlove koje koristite, veb sajtove koje "
"posećujete ni bilo šta po čemu biste mogli biti prepoznati.<nl/>"

#: ui/main.qml:54
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "Pročitajte više o našoj politici privatnosti"

