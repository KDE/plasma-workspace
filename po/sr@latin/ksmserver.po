#: logout.cpp:260
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "„%1“ prekinu odjavljivanje"

#: logout.cpp:354
#, kde-format
msgctxt "@info:status"
msgid "Session is exiting"
msgstr "Sesija se napušta"

#: main.cpp:69 main.cpp:77
#, kde-format
msgid "No write access to '%1'."
msgstr "Nema pristupa za pisanje nad „%1“."

#: main.cpp:71 main.cpp:79
#, kde-format
msgid "No read access to '%1'."
msgstr "Nema pristupa za čitanje nad „%1“."

#: main.cpp:84
#, kde-format
msgid ""
"The following installation problem was detected\n"
"while trying to start Plasma:"
msgstr ""
"Otkriven je sledeći problem sa instalacijom\n"
"pri pokretanju Plasme:"

#: main.cpp:87
#, kde-format
msgid ""
"\n"
"\n"
"Plasma is unable to start.\n"
msgstr ""
"\n"
"\n"
"Plasma ne može da se pokrene.\n"

#: main.cpp:111
#, kde-format
msgid ""
"The reliable Plasma session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pouzdan menadžer sesija Plasme koji komunicira standardnim\n"
"X‑ovim protokolom za upravljanje sesijama (XSMP)."

#: main.cpp:115
#, kde-format
msgid "Restores the saved user session if available"
msgstr "Obnavlja sačuvanu korisničku sesiju (ako postoji)."

#: main.cpp:118
#, kde-format
msgid "Also allow remote connections"
msgstr "Takođe dozvoli udaljene veze"

#: server.cpp:764
#, kde-format
msgctxt "@label an unknown executable is using resources"
msgid "[unknown]"
msgstr "[nepoznato]"

#: server.cpp:787
#, kde-kuit-format
msgctxt "@label notification; %1 is a list of executables"
msgid ""
"Unable to manage some apps because the system's session management resources "
"are exhausted. Here are the top three consumers of session resources:\n"
"%1"
msgstr ""
"Ne mogu da upravljam nekim programima jer su sistemski resursi za "
"upravljanje sesijama iscrpljeni. Evo tri najveća potrošača resursa sesije:\n"
"%1"

#: server.cpp:1042
#, kde-kuit-format
msgctxt "@label notification; %1 is an executable name"
msgid ""
"Unable to restore <application>%1</application> because it is broken and has "
"exhausted the system's session restoration resources. Please report this to "
"the app's developers."
msgstr ""
"Ne mogu da obnovim <application>%1</application> jer je program pokvaren i "
"iscrpeo je sistemske resurse za obnavljanje sesije. Prijavite ovo njegovim "
"programerima."
