#: module.cpp:68
#, kde-format
msgctxt "@title"
msgid "Memory Shortage Avoided"
msgstr "Izbegnuta nestašica memorije"

#: module.cpp:71
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<command>%1</command> has been terminated by the Linux kernel because the "
"system is low on memory. Consider closing unused applications or browser "
"tabs."
msgstr ""
"Jezgro Linuxa je obustavilo <command>%1</command> jer sistemu ponestaje "
"memorije. Razmislite o zatvaranju nekorišćenih programa ili jezičaka "
"pregledača."

#: module.cpp:77
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The background service <command>%1</command> has been terminated by the "
"Linux kernel because the system is low on memory. Consider closing unused "
"applications or browser tabs."
msgstr ""
"Jezgro Linuxa je obustavilo pozadinski servis <command>%1</command> jer "
"sistemu ponestaje memorije. Razmislite o zatvaranju nekorišćenih programa "
"ili jezičaka pregledača."

#: module.cpp:85
#, kde-format
msgctxt "@action"
msgid "Restart Application"
msgstr "Ponovo pokreni program"
