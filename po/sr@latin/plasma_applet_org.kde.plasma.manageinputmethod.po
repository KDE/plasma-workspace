#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Tastatura na ekranu"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Isključeno"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dodir i tablica"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dodir, tablica, miš i dodirnik"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Podesi tastature na ekranu…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Tastatura na ekranu: nedostupna\n"
"Kliknite ili tapnite da podesite postavke tastature na ekranu"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Podešeno da se ne prikazuje automatski\n"
"Kliknite ili tapnite da podesite postavke tastature na ekranu"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Trenutno nije aktivno nijedno podržano tekstualno polje\n"
"Kliknite ili tapnite da je prikažete u režimu emulacije hardverske tastature."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Tastatura na ekranu je vidljiva\n"
"Kliknite ili tapnite da sakrijete tastaturu na ekranu."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Prikazuje se automatski pri tapu na tekstualno polje\n"
"Tapnite da podesite postavke tastature na ekranu"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Prikazuje se automatski pri radu sa tekstualnim poljem\n"
"Kliknite ili tapnite da podesite postavke tastature na ekranu"
