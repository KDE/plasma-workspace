#: ui/main.qml:234
#, kde-kuit-format
msgctxt "@info:tooltip Anti-Aliasing"
msgid ""
"Pixels on displays are generally aligned in a grid. Therefore shapes of "
"fonts that do not align with this grid will look blocky and wrong unless "
"<emphasis>anti-aliasing</emphasis> techniques are used to reduce this "
"effect. You generally want to keep this option enabled unless it causes "
"problems."
msgstr ""
"Pikseli na ekranima obično su poravnati u mrežu. Zato će oblici fontova koji "
"se ne poklapaju sa mrežom izgledati uglasto i nepravilno, osim ako se efekat "
"ne ublaži tehnikama <emphasis>omekšavanja</emphasis>. Ovu opciju obično "
"treba držati uključenom, osim ako ne stvara probleme."

#: ui/main.qml:248
#, kde-format
msgid "Exclude range from anti-aliasing"
msgstr "Izuzmi opseg od omekšavanja"

#: ui/main.qml:267 ui/main.qml:291
#, kde-format
msgid "%1 pt"
msgstr "%1 pt"

