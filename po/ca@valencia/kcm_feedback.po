#: ui/main.qml:28
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr ""
"Els Comentaris de l'usuari s'han desactivat centralitzadament. Contacteu amb "
"la vostra distribució."

#: ui/main.qml:33
#, kde-format
msgid "Plasma"
msgstr "Plasma"

# skip-rule: punctuation-period-no
#: ui/main.qml:45
#, kde-format
msgctxt "@info"
msgid ""
"Help KDE improve Plasma by sending system and usage information. This is "
"optional and entirely anonymous—we never collect your personal data, files "
"you use, websites you visit, or information that could identify you."
msgstr ""
"Ajudeu KDE a millorar Plasma enviant informació del sistema i de l'ús. Açò "
"és opcional i totalment anònim. Mai s'arreplegaran les dades personals, els "
"fitxers que utilitzeu, els llocs web que visiteu o informació que vos puga "
"identificar."

#: ui/main.qml:54
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "Llegiu més quant a la nostra política de privadesa"

#: ui/main.qml:64
#, kde-format
msgid "Plasma:"
msgstr "Plasma:"

#: ui/main.qml:117
#, kde-format
msgid "The following information will be sent:"
msgstr "S'enviarà la informació següent:"

#: ui/main.qml:141
#, kde-format
msgid "View sent data:"
msgstr "Visualitza les dades enviades:"
