#: askpasswordagent.cpp:51
#, kde-format
msgctxt "@info"
msgid "The password must not exceed %1 byte."
msgid_plural "The password must not exceed %1 bytes."
msgstr[0] "ਪਾਸਵਰਡ %1 ਬਾਈਟ ਤੋਂ ਵੱਧ ਨਹੀਂ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"
msgstr[1] "ਪਾਸਵਰਡ %1 ਬਾਈਟਾਂ ਤੋਂ ਵੱਧ ਨਹੀਂ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"

#: askpasswordagent.cpp:247
#, kde-format
msgctxt "@title:window"
msgid "Password Required"
msgstr "ਪਾਸਵਰਡ ਚਾਹੀਦਾ ਹੈ"

#: askpasswordagent.cpp:249
#, kde-format
msgctxt "@label"
msgid "Password:"
msgstr "ਪਾਸਵਰਡ:"

#: askpasswordagent.cpp:289
#, kde-format
msgctxt "@info"
msgid "Could not send the password response. Please try again."
msgstr "ਪਾਸਵਰਡ ਜਵਾਬ ਭੇਜਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਫੇਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
