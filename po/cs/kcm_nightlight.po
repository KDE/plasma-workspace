#: ui/DayNightView.qml:154
#, kde-format
msgid ""
"Color temperature begins changing to night time at %1 and is fully changed "
"by %2"
msgstr "Teplota barvy se začne měnit na noční v %1 a plně změněna je v %2"

#: ui/DayNightView.qml:157
#, kde-format
msgid ""
"Color temperature begins changing to day time at %1 and is fully changed by "
"%2"
msgstr "Teplota barvy se začne měnit na denní v %1 a plně změněna je v %2"

#: ui/main.qml:104
#, kde-format
msgctxt "@info"
msgid "The blue light filter makes the colors on the screen warmer."
msgstr "Filtr modré barvy způsobí, že barvy na monitoru jsou teplejší."

#: ui/main.qml:117
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily activated until %1."
msgstr "Noční světlo je dočasně aktivováno do %1."

#: ui/main.qml:119
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily activated until it is manually turned off."
msgstr "Noční světlo je dočasně aktivováno, dokud není ručně vypnuto."

#: ui/main.qml:121
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily suspended until %1."
msgstr "Noční světlo je dočasně pozastaveno do %1."

#: ui/main.qml:123
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily suspended until it is manually resumed."
msgstr ""
"Noční světlo je dočasně pozastaveno, dokud nebude ručně znovu obnoveno."

#: ui/main.qml:130
#, kde-format
msgctxt "@action:button turn off Night Light feature"
msgid "Turn Off"
msgstr "Vypnout"

#: ui/main.qml:141
#, kde-format
