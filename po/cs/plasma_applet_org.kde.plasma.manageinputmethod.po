#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Klávesnice na obrazovce"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Zakázáno"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dotykové zařízení a tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dotykové zařízení, tablet, myš a touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Nastavení klávesnic na obrazovce…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Klávesnice na obrazovce: není k dispozici\n"
"Kliknutím nebo klepnutím nastavte parametry klávesnice na obrazovce"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Nastaveno tak, aby se nezobrazovalo automaticky\n"
"Kliknutím nebo klepnutím nastavte parametry klávesnice na obrazovce"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"V současné době není aktivní žádné pole pro zadávání textu\n"
"Kliknutím nebo klepnutím přepnete do režimu emulace hardwarové klávesnice."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Klávesnice na obrazovce je viditelná\n"
"Kliknutím nebo klepnutím klávesnici na obrazovce skryjete."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Zobrazí se automaticky po klepnutí na textové pole\n"
"Klepnutím nastavíte parametry klávesnice na obrazovce"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Zobrazí se automaticky při interakci s textovým polem\n"
"Kliknutím nebo klepnutím nastavte parametry klávesnice na obrazovce"

