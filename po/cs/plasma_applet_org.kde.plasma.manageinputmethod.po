#~ msgstr "Virtuální klávesnice: nedostupná"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtuální klávesnice: zakázána"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Zobrazit virtuální klávesnici"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtuální klávesnice: viditelná"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtuální klávesnice: Zobrazit při zadávání bez myši"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtuální klávesnice: Zobrazit u všech vstupních zařízení"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtuální klávesnice: povolena"
