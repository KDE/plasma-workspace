#: ui/DayNightView.qml:154
#, kde-format
msgid ""
"Color temperature begins changing to night time at %1 and is fully changed "
"by %2"
msgstr ""
"Sik-tshái un-tōo tī %1 khai-sí piàn-tsò iā-kan, kàu %2 uân-sîng piàn-huà"

#: ui/DayNightView.qml:157
#, kde-format
msgid ""
"Color temperature begins changing to day time at %1 and is fully changed by "
"%2"
msgstr ""
"Sik-tshái un-tōo tī %1 khai-sí piàn-tsò ji̍t-kan, kàu %2 uân-sîng piàn-huà"

#: ui/main.qml:39
#, kde-format
msgctxt "@info"
msgid "The blue light filter makes the colors on the screen warmer."
msgstr "Nâ-kng lī-á ē hōo îng-bōo tíng-kuân ê sik-tshái khah un-luán."

#: ui/main.qml:50
#, kde-format
msgctxt "@label:listbox Night Light modes"
msgid "Switching times:"
msgstr "Tshiat-uānn sî-kan:"

#: ui/main.qml:61
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Always off"
msgstr "It-ti̍t kuainn"

#: ui/main.qml:62
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Always on"
msgstr "It-ti̍t khui"

#: ui/main.qml:63
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Sunrise and sunset"
msgstr "Ji̍t-tshut kap ji̍t-lo̍h"

#: ui/main.qml:80
#, kde-format
msgctxt "@action:button Configure day-night cycle times"
msgid "Configure…"
msgstr "Siat-tīng…"

