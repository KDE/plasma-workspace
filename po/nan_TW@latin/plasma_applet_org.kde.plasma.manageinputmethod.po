#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Îng-bōo Khí-puânn"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Thîng-iōng"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Tshiok-khòng kap Uē-tôo-pán"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Tshiok-khòng, Uē-tôo-pán, Ku̍t-tshí kap Uē-tôo-pán"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Siat-tīng Îng-bōo Khí-puânn…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Îng-bōo Khí-puânn: bē-sái iōng\n"
"Tiám tse lâi siat-tīng îng-bōo khí-puânn"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Siat-tīng mài tsū-tōng hián-sī\n"
"Tiám tse lâi siat-tīng îng-bōo khí-puânn"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Tsit-má bô tsi-uān ê bûn-jī lân-uī ū leh iōng\n"
"Tiám tse lâi iōng ngē-thé khí-puânn bôo-gí bôo-sik lâi hián-sī."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Îng-bōo Khí-puânn tsit-má ē-khuànn--ê\n"
"Tiám tse lâi kā îng-bōo khí-puânn ún-tsông."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Tiám bûn-jī lân-uī ê sî-tsūn tsū-tōng hián-sī\n"
"Tiám tse lâi siat-tīng îng-bōo khí-puânn"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Kap bûn-jī lân-uī hōo-tōng ê sî-tsūn tsū-tōng hián-sī\n"
"Tiám tse lâi siat-tīng îng-bōo khí-puânn"
