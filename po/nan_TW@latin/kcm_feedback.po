#: ui/main.qml:32
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr ""
"Iōng-tsiá Huê-kuī í-king hōo tiong-sim-huà ê hong-sik thîng-iōng--tiāu--ah. "
"Tshiánn kap lí-ê huat-hîng-tsiá liân-lo̍k."

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info"
msgid ""
"You can help KDE improve Plasma by contributing information on how you use "
"it, so we can focus on things that matter to you.<nl/><nl/>Contributing this "
"information is optional and entirely anonymous. We never collect your "
"personal data, files you use, websites you visit, or information that could "
"identify you.<nl/>"
msgstr ""
"Lí ē-sái kòng-hiàn lí án-ná iōng KDE Plasma ê tsu-sìn hōo KDE, lâi pang-tsōo "
"KDE kái-siān Plasma.<nl/><nl/>Tsit-ê tsu-sìn ê kòng-hiàn sī bô pit-iàu mā-sī "
"uân-tsuân li̍k-miâ--ê. Guán tsua̍t-tuì bē siu-tsi̍p lí-ê kò-jîn tsu-liāu, iōng-"
"liáu siánn-mih tóng-àn, pài-hóng siánn-mih bāng-tsām, á-sī jīm-hô ē-sái piān-"
"sik--tshut lí sī siáng ê tsu-sìn.<nl/>"

#: ui/main.qml:51
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "KDE ê ún-su-khuân tsìng-tshik"

