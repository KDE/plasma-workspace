#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Экранная клавиатура"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Отключено"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Сенсорный экран и планшет"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Сенсорный экран, планшет, мышь и сенсорная панель"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Настроить экранные клавиатуры…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Экранная клавиатура: недоступна\n"
"\n"
"Нажмите или коснитесь, чтобы настроить параметры экранной клавиатуры"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Настроено не отображать автоматически\n"
"\n"
"Нажмите или коснитесь, чтобы настроить параметры экранной клавиатуры"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"В данный момент нет активного поддерживаемого текстового поля\n"
"\n"
"Нажмите или коснитесь для отображения в режиме эмуляции аппаратной "
"клавиатуры."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Экранная клавиатура отображается\n"
"\n"
"Нажмите или коснитесь, чтобы скрыть экранную клавиатуру."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Показывается автоматически при касании текстового поля\n"
"\n"
"Коснитесь для настройки параметров экранной клавиатуры"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Отображается автоматически при взаимодействии с текстовым полем\n"
"\n"
"Нажмите или коснитесь, чтобы настроить параметры экранной клавиатуры"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Экранная клавиатура недоступна"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Экранная клавиатура отключена"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Показать виртуальную клавиатуру"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Экранная клавиатура видима"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Экранная клавиатура: показывать при вводе без мыши"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Экранная клавиатура: показывать при вводе с любых устройств"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Экранная клавиатура включена"
