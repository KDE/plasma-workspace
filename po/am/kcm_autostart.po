#: ui/main.qml:87
#, kde-format
msgctxt "@action:inmenu accessible"
msgid "Add logout script"
msgstr "የመውጫ ስክሪፕት ያክሉ"

#: ui/main.qml:124
#, kde-format
msgid ""
"%1 has not been autostarted yet. Details will be available after the system "
"is restarted."
msgstr "%1 እስካሁን በራስ-ሰር አልተጀመረም። ዝርዝር መረጃው ስርዓቱ እንደገና ከተጀመረ በኋላ ይገኛል።"

#: ui/main.qml:136
#, kde-format
msgctxt "@action:button"
msgid "Disable autostart for %1"
msgstr "ለ%1 በራስ-ሰር መጀመርን አሰናክል"

#: ui/main.qml:137
#, kde-format
msgctxt "@action:button"
msgid "Enable autostart for %1"
msgstr "ለ%1 በራስ-ሰር መጀመርን አንቃ"

#: ui/main.qml:140
#, kde-format
msgctxt "@info:tooltip"
msgid "Disable autostart"
msgstr "በራስ-ሰር መጀመርን አሰናክል"

#: ui/main.qml:141
#, kde-format
msgctxt "@info:tooltip"
msgid "Enable autostart"
msgstr "በራስ-ሰር መጀመርን አንቃ"

#: ui/main.qml:162
#, kde-format
msgctxt ""
"@label Entry hasn't been autostarted because system hasn't been restarted"
msgid "Not autostarted yet"
msgstr "ገና በራስ-ሰር አልተጀመረም"

#: ui/main.qml:171
#, kde-format
msgctxt "@action:button"
msgid "See properties"
msgstr "ፕሮፐርቲዎቹን ይመልከቱ"

#: ui/main.qml:182
#, kde-format
msgctxt "@action:button"
msgid "Remove entry"
msgstr "መግቢያ አስወግድ"

