#: unit.cpp:26
#, kde-format
msgctxt "@label Entry is running right now"
msgid "Running"
msgstr "በሂደት ላይ"

#: unit.cpp:27
#, kde-format
msgctxt "@label Entry is not running right now (exited without error)"
msgid "Not running"
msgstr "እየሄደ አይደለም"

#: unit.cpp:28
#, kde-format
msgctxt "@label Entry is being started"
msgid "Starting"
msgstr "በመጀመር ላይ"

#: unit.cpp:29
#, kde-format
msgctxt "@label Entry is being stopped"
msgid "Stopping"
msgstr "በማቆም ላይ"

#: unit.cpp:30
#, kde-format
msgctxt "@label Entry has failed (exited with an error)"
msgid "Failed"
msgstr "አልተሳካም"

#: unit.cpp:81
#, kde-format
msgid "Error occurred when receiving reply of GetAll call %1"
msgstr "የGetAll ጥሪ %1 ምላሽ ሲቀበል ስህተት ተከስቷል"

#: unit.cpp:153
#, kde-format
msgid "Failed to open journal"
msgstr "journal መክፈት አልተሳካም"
