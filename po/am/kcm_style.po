#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr "\"%1\"ን ማራገፍ አልተሳካም፦ ስታይሉ ጥቅም ላይ እየዋለ ነው።"

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "\"%1\"ን ማራገፍ አልተሳካም፦ %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr "ስታይሎችን ማራገፍ አልተቻለም፦ \n"

#: kcmstyle.cpp:226
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1” but could not uninstall others:\n"
msgstr "በተሳካ ሁኔታ \"%1\"ን አራግፏል ነገር ግን ሌሎችን ማራገፍ አልተቻለም፦\n"

#: kcmstyle.cpp:229
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style but could not uninstall others:\n"
msgid_plural ""
"Successfully uninstalled %1 styles but could not uninstall others:\n"
msgstr[0] "የ%1 ስታይል በተሳካ ሁኔታ ተወግዷል፣ ነገር ግን ሌሎቹን ማራገፍ አልተቻለም፦\n"
msgstr[1] "%1 ስታይሎች  በተሳካ ሁኔታ ተወግደዋል፣ ነገር ግን ሌሎቹን ማራገፍ አልተቻለም፦\n"

#: kcmstyle.cpp:240
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1”."
msgstr "በተሳካ ሁኔታ \"%1\" ን አራግፏል።"

#: kcmstyle.cpp:242
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style"
msgid_plural "Successfully uninstalled %1 styles."
msgstr[0] "በተሳካ ሁኔታ የ %1  ስታይል አራግፏል"
msgstr[1] "በተሳካ ሁኔታ የ %1 ስታይሎች አራግፏል."

#: kcmstyle.cpp:306 kcmstyle.cpp:313
#, kde-format
msgid "There was an error loading the configuration dialog for this style."
