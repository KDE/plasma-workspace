#: src/fingerprintmodel.cpp:144 src/fingerprintmodel.cpp:228
#, kde-format
msgid "No fingerprint device found."
msgstr "የጣት አሻራ መሳሪያ አልተገኘም።"

#: src/fingerprintmodel.cpp:301
#, kde-format
msgid "Retry scanning your finger."
msgstr "ጣትዎን እንደገና ለመቃኘት ይሞክሩ።"

#: src/fingerprintmodel.cpp:303
#, kde-format
msgid "Swipe too short. Try again."
msgstr "ጣትዎን በበቂ ርዝመት አላንሸራተቱም። እንደገና ይሞክሩ።"

#: src/fingerprintmodel.cpp:305
#, kde-format
msgid "Finger not centered on the reader. Try again."
msgstr "ጣትዎ በመቀበያው መሃል ላይ አይደለም። እንደገና ይሞክሩ።"

#: src/fingerprintmodel.cpp:307
#, kde-format
msgid "Remove your finger from the reader, and try again."
msgstr "ጣትዎን ከመቀበያው ላይ ያስወግዱ እና እንደገና ይሞክሩ።"

#: src/fingerprintmodel.cpp:315
#, kde-format
msgid "Fingerprint enrollment has failed."
msgstr "የጣት አሻራ ምዝገባ አልተሳካም።"

#: src/fingerprintmodel.cpp:318
#, kde-format
msgid ""
"There is no space left for this device, delete other fingerprints to "
"continue."
msgstr "ለዚህ መሳሪያ የቀረ ቦታ የለም፣ ለመቀጠል ሌሎች የጣት አሻራዎችን ሰርዝ።"

#: src/fingerprintmodel.cpp:321
#, kde-format
msgid "The device was disconnected."
msgstr "መሣሪያው ተቋርጧል።"

#: src/fingerprintmodel.cpp:326
#, kde-format
msgid "An unknown error has occurred."
msgstr "ያልታወቀ ስህተት ተከስቷል።"

