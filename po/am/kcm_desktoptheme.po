#. i18n: ectx: label, entry (name), group (Theme)
#: desktopthemesettings.kcfg:9
#, kde-format
msgid "Name of the current Plasma Style"
msgstr "የአሁኑ የPlasma ስታይል ስም"

#: kcm.cpp:111
#, kde-format
msgid "Unable to create a temporary file."
msgstr "ጊዜያዊ ፋይል መፍጠር አልተቻለም።"

#: kcm.cpp:122
#, kde-format
msgid "Unable to download the theme: %1"
msgstr "ገጽታውን ማውረድ አልተቻለም፦ %1"

#: kcm.cpp:147
#, kde-format
msgid "Theme installed successfully."
msgstr "ገጽታው በተሳካ ሁኔታ ተጭኗል።"

#: kcm.cpp:150 kcm.cpp:156
#, kde-format
msgid "Theme installation failed."
msgstr "ገጽታውን መጫን አልተሳካም።"

#: kcm.cpp:250
#, kde-format
msgid "Removing theme failed: %1"
msgstr "ገጽታውን ማስወገድ አልተሳካም፡ %1"

#: plasma-apply-desktoptheme.cpp:33
#, kde-format
msgid ""
"This tool allows you to set the theme of the current Plasma session, without "
"accidentally setting it to one that is either not available, or which is "
"already set."
msgstr ""
"ይህ መሳሪያ፣ በአሁኑ የPlasma ክፍለ ጊዜ (session) ላይ፣ የማይገኝ ወይም ቀድሞውኑ የተመረጠ ገጽታ (theme) "
"በስህተት እንዳይመደብ በመከላከል፣ ተገቢውን ገጽታ እንዲያዘጋጁ ያስችልዎታል።"

#: plasma-apply-desktoptheme.cpp:37
#, kde-format
msgid ""
"The name of the theme you wish to set for your current Plasma session "
"(passing a full path will only use the last part of the path)"
msgstr ""
"ለአሁኑ የPlasma ክፍለ ጊዜ ማዘጋጀት የሚፈልጉት የገጽታ ስም። (ሙሉ የፋይል ዱካ ካስገቡ፣ የዱካው የመጨረሻ ክፍል "
"ብቻ ጥቅም ላይ ይውላል።)"

#: plasma-apply-desktoptheme.cpp:38
#, kde-format
msgid ""
"Show all the themes available on the system (and which is the current theme)"
msgstr "በስርዓቱ ላይ ያሉትን ገጽታዎች በሙሉ አሳይ (እንዲሁም አሁን ጥቅም ላይ እየዋለ ያለውን ገጽታ አመልክት)"

#: plasma-apply-desktoptheme.cpp:55
#, kde-format
msgid ""
"The requested theme \"%1\" is already set as the theme for the current "
"Plasma session."
msgstr "የተጠየቀው ገጽታ \"%1” ለአሁኑ የPlasma ክፍለ ጊዜ እንደ ገጽታ ሆኖ አስቀድሞ ተዋቅሯል።"

#: plasma-apply-desktoptheme.cpp:76
#, kde-format
msgid "The current Plasma session's theme has been set to %1"
msgstr "የአሁኑ የPlasma ክፍለ ጊዜ ገጽታ ወደ %1 ተቀናብሯል"

#: plasma-apply-desktoptheme.cpp:78
#, kde-format
msgid ""
"Could not find theme \"%1\". The theme should be one of the following "
"options: %2"
msgstr "\"%1” የሚል ገጽታ (theme) ማግኘት አልተቻለም። ገጽታው ከሚከተሉት አማራጮች አንዱ መሆን አለበት፦ %2"

#: plasma-apply-desktoptheme.cpp:86
#, kde-format
msgid "You have the following Plasma themes on your system:"
msgstr "በስርዓትዎ ላይ የሚከተሉት የPlasma ገጽታዎች አሉዎት፦"

#: ui/main.qml:101
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "All themes"
msgstr "ሁሉም ገጽታዎች"

#: ui/main.qml:102
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Light themes"
msgstr "ብሩህ ገጽታዎች"

#: ui/main.qml:103
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Dark themes"
msgstr "ጨለማ ገጽታዎች"

#: ui/main.qml:104
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Color scheme compatible"
msgstr "ከቀለም አወቃቀሩ ጋር የሚስማማ"

#: ui/main.qml:114
#, kde-format
msgid "Install from File…"
msgstr "ከፋይል ጫን…"

#: ui/main.qml:119
#, kde-format
msgid "Get New…"
msgstr "አዲስ ያግኙ…"

#: ui/main.qml:132
#, kde-format
msgid "Follows color scheme"
msgstr "የቀለም አወቃቀሩን ይከተላል"

#: ui/main.qml:150
#, kde-format
msgid "Edit Theme…"
msgstr "ገጽታ አርትዕ(Edit)…"

#: ui/main.qml:158
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove Plasma style"
msgstr "የPlasma ስታይልን ያስወግዱ"

#: ui/main.qml:160
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active Plasma style"
msgstr "በአሁኑ ጊዜ ጥቅም ላይ እየዋለ ያለውን የPlasma ስታይል መሰረዝ አይቻልም"

#: ui/main.qml:162
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed Plasma styles"
msgstr "በስርዓቱ የተጫኑ የPlasma ስታይሎችን መሰረዝ አይቻልም"

#: ui/main.qml:170
#, kde-format
msgctxt "@info:tooltip"
msgid "Don’t delete this Plasma style"
msgstr "ይህንን የPlasma ስታይል አትሰርዝ"

#: ui/main.qml:189
#, kde-format
msgid "Open Theme"
msgstr "ገጽታ ክፍት"

#: ui/main.qml:191
#, kde-format
msgid "Theme Files (*.zip *.tar.gz *.tar.bz2)"
msgstr "ገጽታ ፋይሎች (*.zip *.tar.gz *.tar.bz2)"
