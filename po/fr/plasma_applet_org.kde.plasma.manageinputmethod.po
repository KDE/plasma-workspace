#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Clavier virtuel"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Désactivé"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Périphérique tactile et tablette"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Périphérique tactile, tablette, souris et pavé tactile"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Configurer les claviers virtuels…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Clavier virtuel : indisponible.\n"
"Veuillez cliquer ou tapoter pour modifier la configuration du clavier "
"virtuel."

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Configuré pour un affichage non automatique.\n"
"Veuillez cliquer ou tapoter pour modifier la configuration du clavier "
"virtuel."

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Le clavier virtuel est visible.\n"
"Veuillez cliquer ou tapoter pour masquer le clavier virtuel."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"S'affiche automatiquement lors d'un tapotage dans un champ de texte.\n"
"Veuillez tapoter pour modifier la configuration du clavier virtuel."

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"S'affiche automatiquement lors d'une interaction avec un champ de texte.\n"
"Veuillez cliquer ou tapoter pour modifier la configuration du clavier "
"virtuel."

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Clavier virtuel : indisponible"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Clavier virtuel : désactivé"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Afficher le clavier virtuel…"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Clavier virtuel : visible"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr ""
#~ "Clavier virtuel : affichage sur un périphérique d'entrée sans souris"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Clavier virtuel : affichage sur tous les périphérique d'entrée"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Clavier virtuel : activé"
