#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "ეკრანის კლავიატურა"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "გამორთულია"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "შეხებით და ტაბლეტით"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "შეხებით, ტაბლეტით, თაგუნათი და სენსორული პანელით"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "ეკრანის კლავიატურების მორგება…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"ეკრანის კლავიატურა: ხელმიუწვდომელია\n"
"დააწკაპუნეთ, ან დაატყაპუნეთ ეკრანის კლავიატურის მოსარგებად"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"მორგებულია, რომ ავტომატურად არ გამოჩნდეს\n"
"დააწკაპუნეთ, ან დაატყაპუნეთ ეკრანის კლავიატურის მოსარგებად"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"ამჟამად აქტიურია მხარდაუჭერელი ტექსტის ტექსტური ველი\n"
"დააწკაპუნეთ, ან დაატყაპუნეთ აპარატურული კლავიატურის ემულაციის რეჟიმში "
"საჩვენებლად."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"ეკრანის კლავიატურა ხილულია\n"
"დააწკაპუნეთ, ან დაატყაპუნეთ მის დასამალად."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"გამოჩნდება ავტომატურად ტექსტურ ველზე დატყაპუნებისას\n"
"დაატყაპუნეთ ეკრანის კლავიატურის მოსარგებად"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"გამოჩნდება ავტომატურად ტექსტურ ველთან ინტერაქციისას\n"
"დააწკაპუნეთ, ან დაატყაპუნეთ ეკრანის კლავიატურის მოსარგებად"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "ვირტუალური კლავიატურა: მიუწვდომელია"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "ვირტუალური კლავიატურა: გამორთულია"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "ვირტუალური კლავიატურის ჩვენება"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "ვირტუალური კლავიატურა: ჩანს"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "ვირტუალური კლავიატურა: ჩვენება არა-თაგუნათი შეყვანისას"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "ვირტუალური კლავიატურა: ჩვენება ყველა შეყვანის მოწყობილობით"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "ვირტუალური კლავიატურა: ჩართული"
