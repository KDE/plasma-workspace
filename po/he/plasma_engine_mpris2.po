#: multiplexedservice.cpp:72
#, kde-format
msgctxt "Name for global shortcuts category"
msgid "Media Controller"
msgstr "פקד מדיה"

#: multiplexedservice.cpp:74
#, kde-format
msgid "Play/Pause media playback"
msgstr "הפעלת/השהיית ניגון מדיה"

#: multiplexedservice.cpp:92
#, kde-format
msgid "Media playback next"
msgstr "הבא"

#: multiplexedservice.cpp:101
#, kde-format
msgid "Media playback previous"
msgstr "הקודם"

#: multiplexedservice.cpp:110
#, kde-format
msgid "Stop media playback"
msgstr "עצירת נגינת המדיה"

#: multiplexedservice.cpp:119
#, kde-format
msgid "Pause media playback"
msgstr "השהיית נגינת המדיה"

#: multiplexedservice.cpp:128
#, kde-format
msgid "Play media playback"
msgstr "הפעלת ניגון מדיה"

#: multiplexedservice.cpp:137
#, kde-format
msgid "Media volume up"
msgstr "הגברת עוצמת שמע של מדיה"

#: multiplexedservice.cpp:146
#, kde-format
msgid "Media volume down"
msgstr "הנמכת עוצמת שמע של מדיה"

#: playeractionjob.cpp:169
#, kde-format
msgid "The media player '%1' cannot perform the action '%2'."
msgstr "נגן המדיה ‚%1’ לא יכול לבצע את הפעולה ‚%2’."

#: playeractionjob.cpp:171
#, kde-format
msgid "Attempting to perform the action '%1' failed with the message '%2'."
msgstr "ביצוע הפעולה ‚%1’ נכשל עם ההודעה ‚%2’."

#: playeractionjob.cpp:173
#, kde-format
msgid "The argument '%1' for the action '%2' is missing or of the wrong type."
msgstr "הארגומנט ‚%1’ עבור הפעולה ‚%2’ חסר או מהטיפוס הלא נכון."

#: playeractionjob.cpp:175
#, kde-format
msgid "The operation '%1' is unknown."
msgstr "הפעולה ‚%1’ לא ידועה."

#: playeractionjob.cpp:177
#, kde-format
msgid "Unknown error."
msgstr "שגיאה בלתי מוכרת."
