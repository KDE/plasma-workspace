#: ui/DayNightView.qml:154
#, kde-format
msgid ""
"Color temperature begins changing to night time at %1 and is fully changed "
"by %2"
msgstr ""
"La temperatura del color comença a canviar a l'hora nocturna a les %1 i està "
"totalment canviada a les %2"

#: ui/DayNightView.qml:157
#, kde-format
msgid ""
"Color temperature begins changing to day time at %1 and is fully changed by "
"%2"
msgstr ""
"La temperatura del color comença a canviar a l'hora diürna a les %1 i està "
"totalment canviada a les %2"

#: ui/main.qml:104
#, kde-format
msgctxt "@info"
msgid "The blue light filter makes the colors on the screen warmer."
msgstr "El filtre de llum blava fa més càlids els colors de la pantalla."

#: ui/main.qml:117
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily activated until %1."
msgstr "La llum de nit està activada temporalment fins a les %1."

#: ui/main.qml:119
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily activated until it is manually turned off."
msgstr ""
"La llum de nit està activada temporalment fins que es desactivi manualment."

#: ui/main.qml:121
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily suspended until %1."
msgstr "La llum de nit està suspesa temporalment fins a les %1."

#: ui/main.qml:123
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily suspended until it is manually resumed."
msgstr ""
"La llum de nit està suspesa temporalment fins que es reprengui manualment."

#: ui/main.qml:130
#, kde-format
msgctxt "@action:button turn off Night Light feature"
msgid "Turn Off"
msgstr "Desactiva"

#: ui/main.qml:141
#, kde-format
msgctxt ""
"@action:button resume Light Light feature, which had been temporarily "
"disabled"
msgid "Resume"
msgstr "Reprèn"

