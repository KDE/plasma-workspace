#: gtkpage.cpp:57
#, kde-format
msgid "%1 is not a valid GTK Theme archive."
msgstr "El %1no és un arxiu vàlid de tema GTK."

#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr ""
"La instal·lació ha fallat: No es pot instal·lar un estil des d'una ubicació "
"remota."

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "La instal·lació ha fallat: No s'ha pogut llegir el fitxer d'estil."

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
msgstr "La instal·lació ha fallat: El fitxer d'estil no conté cap dada."

#: kcmstyle.cpp:134
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be unpacked."
msgstr ""
"La instal·lació ha fallat: No s'ha pogut desempaquetar el fitxer d'estil."

#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "La instal·lació ha fallat: No s'ha pogut trobar l'estil."

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr ""
"La instal·lació ha fallat: El fitxer seleccionat no és un estil Union vàlid."

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "La instal·lació ha fallat: No s'admet l'estil seleccionat."

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr "La instal·lació de %1 ha fallat: L'estil ja està instal·lat."

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "La instal·lació de %1 ha fallat: S'ha denegat el permís."

#: kcmstyle.cpp:174
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "La instal·lació de %1 ha fallat: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "«%1» s'ha instal·lat correctament."

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr ""
"Ha fallat la desinstal·lació: No s'ha pogut trobar l'estil amb ID «%1»."

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr "La desinstal·lació de «%1» ha fallat: S'ha denegat el permís."

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr "La desinstal·lació de «%1» ha fallat: L'estil no està instal·lat."

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr "La desinstal·lació de «%1» ha fallat: L'estil està en ús."

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "La desinstal·lació de «%1» ha fallat: %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr "No s'han pogut desinstal·lar els estils:\n"

