#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Teclat en pantalla"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Desactivat"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Tàctil i tauleta"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Tàctil, tauleta, ratolí i ratolí tàctil"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Configura els teclats en pantalla…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Teclat en pantalla: no disponible\n"
"Feu clic o toqueu per a configurar els paràmetres del teclat en pantalla"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Configurat per a no mostrar automàticament\n"
"Feu clic o toqueu per a configurar els paràmetres del teclat en pantalla"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Actualment no hi ha cap camp de text actiu admès\n"
"Feu clic o toqueu per a mostrar-ho en el mode d'emulació de teclat de "
"maquinari."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"El teclat en pantalla és visible\n"
"Feu clic o toqueu per ocultar el teclat en pantalla."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Mostra automàticament en tocar un camp de text\n"
"Toqueu per a configurar els paràmetres del teclat en pantalla"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Mostra automàticament en interactuar amb un camp de text\n"
"Feu clic o toqueu per a configurar els paràmetres del teclat en pantalla"

