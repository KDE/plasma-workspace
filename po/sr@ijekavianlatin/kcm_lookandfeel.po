#. i18n: ectx: label, entry (lookAndFeelPackage), group (KDE)
#: lookandfeelsettings.kcfg:9
#, kde-format
msgid "Global look and feel"
msgstr "Globalni izgled i osjećaj"

#. i18n: ectx: label, entry (defaultLightLookAndFeel), group (KDE)
#. i18n: ectx: label, entry (defaultDarkLookAndFeel), group (KDE)
#: lookandfeelsettings.kcfg:13 lookandfeelsettings.kcfg:17
#, kde-format
msgid "Global Look and Feel package, alternate"
msgstr "Paket globalnog izgleda i osjećaja, alternativni"

#. i18n: ectx: label, entry (automaticLookAndFeel), group (KDE)
#: lookandfeelsettings.kcfg:21
#, kde-format
msgid "Switch between dark and light global themes depending on time of day"
msgstr ""
"Prebacuj između tamne i svijetle globalne teme u zavisnosti od doba dana"

#. i18n: ectx: label, entry (automaticLookAndFeelOnIdle), group (KDE)
#: lookandfeelsettings.kcfg:25
#, kde-format
msgid "Switch between dark and light global themes when the computer is idle"
msgstr "Prebacuj između tamne i svijetle globalne teme kada računar miruje"

#. i18n: ectx: label, entry (automaticLookAndFeelIdleInterval), group (KDE)
#: lookandfeelsettings.kcfg:29
#, kde-format
msgid ""
"How long the computer should be idle in order to switch between dark and "
"light global themes, in seconds"
msgstr ""
"Koliko dugo računar treba da miruje da bi se prebacilo između tamne i "
"svijetle globalne teme, u sekundama"

#: tool/lnftool.cpp:32
#, kde-format
msgid "Global Theme Tool"
msgstr "Alatka za globalne teme"

#: tool/lnftool.cpp:34
#, kde-format
msgid ""
"Command line tool to apply global theme packages for changing the look and "
"feel."
msgstr ""
"Alatka komandne linije za primjenu paketa globalnih tema radi promjene "
"izgleda i osjećaja."

#: tool/lnftool.cpp:36
#, kde-format
msgid "Copyright 2017, Marco Martin"
msgstr "© 2017, Marko Martin"

#: tool/lnftool.cpp:37
#, kde-format
msgid "Marco Martin"
msgstr "Marko Martin"

#: tool/lnftool.cpp:37
#, kde-format
msgid "Maintainer"
msgstr "Održavalac"

#: tool/lnftool.cpp:46
#, kde-format
msgid "List available global theme packages"
msgstr "Nabroji dostupne pakete globalnih tema"

#: tool/lnftool.cpp:49
#, kde-format
msgid ""
"Apply a global theme package. This can be the name of a package, or a full "
"path to an installed package, at which point this tool will ensure it is a "
"global theme package and then attempt to apply it"
msgstr ""
"Primijeni paket globalne teme. Ovo može biti ime paketa ili puna putanja do "
"instaliranog paketa, kada će ova alatka provjeriti da li je to paket "
"globalne teme i zatim pokušati da ga primijeni"

#: tool/lnftool.cpp:51
#, kde-format
msgid "packagename"
msgstr "ime‑paketa"

#: tool/lnftool.cpp:52
#, kde-format
msgid "Prevent --apply from disabling the automatic mode"
msgstr "Spriječi da --apply isključi automatski režim"

#: tool/lnftool.cpp:53
#, kde-format
msgid "Reset the Plasma Desktop layout"
msgstr "Resetuj raspored plasma površi"

