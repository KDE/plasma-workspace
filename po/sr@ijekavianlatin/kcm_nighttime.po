#: ui/main.qml:26
#, kde-format
msgctxt "@info"
msgid ""
"Time-based features such as Night Light and dynamic wallpapers can be "
"synchronized with the day-night cycle. Choose your preferred cycle here."
msgstr ""
"Mogućnosti zasnovane na vremenu, poput noćnog svjetla i dinamičkih tapeta, "
"mogu se uskladiti sa smjenom dana i noći. Ovdje izaberite željenu smjenu."

#: ui/main.qml:63
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: 'Determine sunrise and sunset times "
"[based on]'"
msgid "Determine sunrise and sunset times:"
msgstr "Vrijeme izlaska i zalaska sunca:"

#: ui/main.qml:68
#, kde-format
msgctxt ""
"@item:inlistbox part of a sentence: 'Determine sunrise and sunset times'"
msgid "Based on device's location"
msgstr "prema lokaciji uređaja"

#: ui/main.qml:69
#, kde-format
msgctxt ""
"@item:inlistbox part of a sentence: 'Determine sunrise and sunset times'"
msgid "Using custom times"
msgstr "prema posebno zadatim vremenima"

