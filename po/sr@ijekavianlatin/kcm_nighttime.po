msgid "Sunrise starts at %1 and ends at %2"
msgstr "Izlazak sunca počinje u %1 i završava se u %2"

#: ui/SunPath.qml:57
#, kde-format
msgctxt "@label"
msgid "Sunrise"
msgstr "Izlazak sunca"

#: ui/SunPath.qml:77
#, kde-format
msgctxt "@info:tooltip; the variables are times of day, e.g. 07:30"
msgid "Sunset starts at %1 and ends at %2"
msgstr "Zalazak sunca počinje u %1 i završava se u %2"

#: ui/SunPath.qml:82
#, kde-format
msgctxt "@label"
msgid "Sunset"
msgstr "Zalazak sunca"

#: ui/SunPath.qml:107
#, kde-format
msgctxt "@info"
msgid ""
"Sunrise and sunset times cannot be determined at your location due to polar "
"day. Choose custom times instead."
msgstr ""
"Ne mogu da odredim vrijeme izlaska i zalaska sunca na vašoj lokaciji zbog "
"polarnog dana. Umjesto toga izaberite posebna vremena."

#: ui/SunPath.qml:109
#, kde-format
msgctxt "@info"
msgid ""
"Sunrise and sunset times cannot be determined at your location due to polar "
"night. Choose custom times instead."
msgstr ""
"Ne mogu da odredim vrijeme izlaska i zalaska sunca na vašoj lokaciji zbog "
"polarne noći. Umjesto toga izaberite posebna vremena."

#: ui/SunPath.qml:111
#, kde-format
msgctxt "@info"
msgid ""
"Sunrise and sunset times cannot be reliably determined at your location. "
"Choose custom times instead."
msgstr ""
"Ne mogu pouzdano da odredim vrijeme izlaska i zalaska sunca na vašoj "
"lokaciji. Umjesto toga izaberite posebna vremena."

