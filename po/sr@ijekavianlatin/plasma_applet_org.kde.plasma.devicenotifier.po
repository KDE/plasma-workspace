#: actions/checkaction.cpp:71
#, kde-format
msgctxt "@action:button check a storageAccess (i.e disk) for error"
msgid "Check for Errors"
msgstr "Provjeri ima li grešaka"

#: actions/mountaction.cpp:93
#, kde-format
msgid "Mount"
msgstr "Montiraj"

#: actions/mountandopenaction.cpp:177
#, kde-format
msgid "Open in File Manager"
msgstr "Otvori u menadžeru fajlova"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Try to Fix"
msgstr "Pokušaj da popraviš"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Mount and Open"
msgstr "Montiraj i otvori"

#: actions/mountandopenaction.cpp:182
#, kde-format
msgid "Eject"
msgstr "Izbaci"

#: actions/mountandopenaction.cpp:184
#, kde-format
msgid "Safely remove"
msgstr "Bezbjedno ukloni"

#: messageinfo.cpp:108
#, kde-format
msgid "This device has file system errors."
msgstr "Ovaj uređaj ima greške u fajl sistemu."

#: messageinfo.cpp:110
#, kde-format
msgctxt "@label device is a storage disk"
msgid "This device has no errors"
msgstr "Ovaj uređaj nema grešaka"

#: messageinfo.cpp:113
#, kde-format
msgid "Successfully repaired!"
msgstr "Uspješno popravljeno!"

#: messageinfo.cpp:117
#, kde-format
msgid "Device Status"
msgstr "Stanje uređaja"

#: messageinfo.cpp:118
#, kde-format
msgid "A device can now be safely removed"
msgstr "Uređaj sada možete bezbjedno ukloniti"

#: messageinfo.cpp:122
#, kde-format
msgid "This device can now be safely removed."
msgstr "Ovaj uređaj sada možete bezbjedno ukloniti."

#: messageinfo.cpp:129
#, kde-format
msgid "You are not authorized to mount this device."
msgstr "Niste ovlašćeni da montirate ovaj uređaj."

#: messageinfo.cpp:133
#, kde-format
msgid "You are not authorized to eject this disc."
msgstr "Niste ovlašćeni da izbacite ovaj disk."

#: messageinfo.cpp:136
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "You are not authorized to remove this device."
msgstr "Niste ovlašćeni da uklonite ovaj uređaj."

#: messageinfo.cpp:139
#, kde-format
msgid "You are not authorized to repair this device."
msgstr "Niste ovlašćeni da popravite ovaj uređaj."

#: messageinfo.cpp:141 messageinfo.cpp:208
#, kde-format
msgid "Unknown error type"
msgstr "Nepoznata vrsta greške"

#: messageinfo.cpp:145
#, kde-format
msgid "Could not mount this device as it is busy."
msgstr "Ne mogu da montiram ovaj uređaj jer je zauzet."

#: messageinfo.cpp:173
#, kde-format
msgid "One or more files on this device are open within an application."
msgstr "Jedan ili više fajlova na ovom uređaju otvoreni su u nekom programu."

#: messageinfo.cpp:175
#, kde-format
msgid "One or more files on this device are opened in application \"%2\"."
msgid_plural ""
"One or more files on this device are opened in following applications: %2."
msgstr[0] ""
"Jedan ili više fajlova na ovom uređaju otvoreni su u sljedećim programima: "
"%2."
msgstr[1] ""
"Jedan ili više fajlova na ovom uređaju otvoreni su u sljedećim programima: "
"%2."
msgstr[2] ""
"Jedan ili više fajlova na ovom uređaju otvoreni su u sljedećim programima: "
"%2."
msgstr[3] "Jedan ili više fajlova na ovom uređaju otvoreni su u programu „%2“."

#: messageinfo.cpp:178
#, kde-format
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr ", "

#: messageinfo.cpp:197
#, kde-format
msgid "Could not mount this device."
msgstr "Ne mogu da montiram ovaj uređaj."

#: messageinfo.cpp:201
#, kde-format
msgid "Could not eject this disc."
msgstr "Ne mogu da izbacim ovaj disk."

#: messageinfo.cpp:203
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "Could not remove this device."
msgstr "Ne mogu da uklonim ovaj uređaj."

#: messageinfo.cpp:206
#, kde-format
msgid "Could not repair this device: %1"
msgstr "Ne mogu da popravim ovaj uređaj: %1"

#: qml/DeviceItem.qml:98
#, kde-format
msgctxt ""
"Translation should be short and mean 'Currently checking the device for "
"filesystem errors'"
msgid "Checking…"
msgstr "Provjeravam…"

#: qml/DeviceItem.qml:100
#, kde-format
msgctxt ""
"Translation should be short and mean 'The storage device contains filesystem "
"errors and is being repaired'"
msgid "Repairing…"
msgstr "Popravljam…"

#: qml/DeviceItem.qml:103
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free of %2"
msgstr "%1 slobodno od %2"

#: qml/DeviceItem.qml:107
#, kde-format
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing…"
msgstr "Pristupam…"

#: qml/DeviceItem.qml:110
#, kde-format
msgctxt ""
"Removing is a less technical word for Unmounting; translation should be "
"short and mean 'Currently unmounting this device'"
msgid "Removing…"
msgstr "Uklanjam…"

#: qml/DeviceItem.qml:113
#, kde-format
msgid "Don't unplug yet! Files are still being transferred…"
msgstr "Još ne izvlačite! Fajlovi se i dalje prenose…"

#: qml/FullRepresentation.qml:47 qml/main.qml:127
#, kde-format
msgid "Remove All"
msgstr "Ukloni sve"

#: qml/FullRepresentation.qml:48
#, kde-format
msgid "Click to safely remove all devices"
msgstr "Kliknite da bezbjedno uklonite sve uređaje"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No removable devices attached"
msgstr "Nema priključenih uklonjivih uređaja"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No disks available"
msgstr "Nema dostupnih diskova"

#: qml/main.qml:76
#, kde-format
msgid "Most Recent Device"
msgstr "Posljednji uređaj"

#: qml/main.qml:76
#, kde-format
msgid "No Devices Available"
msgstr "Nema dostupnih uređaja"

#: qml/main.qml:113
#, kde-format
msgctxt "Open auto mounter kcm"
msgid "Configure Removable Devices…"
msgstr "Podesi uklonjive uređaje…"

#: qml/main.qml:135
#, kde-format
msgid "Removable Devices"
msgstr "Uklonjivi uređaji"

#: qml/main.qml:150
#, kde-format
msgid "Non Removable Devices"
msgstr "Neuklonjivi uređaji"

#: qml/main.qml:165
#, kde-format
msgid "All Devices"
msgstr "Svi uređaji"

#: qml/main.qml:182
#, kde-format
msgid "Show popup when new device is plugged in"
msgstr "Prikaži iskakač kad se utakne novi uređaj"
