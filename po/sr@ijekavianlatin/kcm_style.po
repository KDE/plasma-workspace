"Uspješno deinstaliran jedan stil, ali ne mogu da deinstaliram ostale:\n"

#: kcmstyle.cpp:240
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1”."
msgstr "Uspješno deinstaliran „%1“."

#: kcmstyle.cpp:242
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style"
msgid_plural "Successfully uninstalled %1 styles."
msgstr[0] "Uspješno deinstaliran %1 stil."
