#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "Instaliranje propalo: ne mogu da nađem stil."

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr "Instaliranje propalo: izabrani fajl nije ispravan stil Union."

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "Instaliranje propalo: izabrani stil nije podržan."

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr "Instaliranje „%1“ propalo: stil je već instaliran."

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "Instaliranje „%1“ propalo: dozvola odbijena."

