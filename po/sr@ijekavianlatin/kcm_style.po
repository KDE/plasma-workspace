#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "Instaliranje „%1“ propalo: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "Uspješno instaliran „%1“."

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr "Deinstaliranje propalo: ne mogu da nađem stil sa ID‑om „%1“."

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr "Deinstaliranje „%1“ propalo: dozvola odbijena."

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr "Deinstaliranje „%1“ propalo: stil nije instaliran."

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
