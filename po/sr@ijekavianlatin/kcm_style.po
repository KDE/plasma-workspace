#: gtkpage.cpp:57
#, kde-format
msgid "%1 is not a valid GTK Theme archive."
msgstr "%1 nije ispravna arhiva GTK teme."

#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr "Instaliranje propalo: ne mogu da instaliram stil sa udaljene lokacije."

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "Instaliranje propalo: ne mogu da pročitam fajl stila."

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
