#: desktopview.cpp:303
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Are you sure you want to permanently hide the preview banner?<nl/><nl/>This "
"action can only be undone by removing the line beginning with "
"<icode>ShowDesktopPreviewBanner</icode> in the <filename>kdeglobals</"
"filename> config file."
msgstr ""
"Želite li zaista da trajno sakrijete barjak probnog izdanja?<nl/><nl/>Ova "
"radnja može da se opozove samo uklanjanjem reda koji počinje sa "
"<icode>ShowDesktopPreviewBanner</icode> u postavnom fajlu "
"<filename>kdeglobals</filename>."

