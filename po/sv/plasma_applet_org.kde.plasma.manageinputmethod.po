#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Skärmtangentbord"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Inaktiverat"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Pekskärm och ritplatta"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Pekskärm, ritplatta, mus och pekplatta"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Anpassa skärmtangentbord…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Skärmtangentbord: inte tillgängligt\n"
"Klicka eller tryck för att anpassa skärmtangentbordets inställningar"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Anpassat att inte visas automatiskt\n"
"Klicka eller tryck för att anpassa skärmtangentbordets inställningar"

#: qml/main.qml:156
#, fuzzy, kde-format
#| msgctxt ""
#| "@info:tooltip Hardware emulation mode means it acts like a regular dumb "
#| "keyboard (no input-method features like preedit/word suggestions/etc)"
#| msgid ""
#| "No supported text text field is currently active\n"
#| "Click or tap to show in hardware keyboard emulation mode."
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Inget textfält som stöds är för närvarande aktivt\n"
"Klicka eller tryck för att visa i emuleringsläge för maskinvarutangentbord."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Skärmtangentbordet är synligt Klicka eller tryck för att dölja "
"skärmtangentbordet."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Visas automatiskt vid tryck på ett textfält\n"
"Tryck för att anpassa skärmtangentbordets inställningar"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Visas automatiskt vid interaktion med ett textfält\n"
"Tryck för att anpassa skärmtangentbordets inställningar"

