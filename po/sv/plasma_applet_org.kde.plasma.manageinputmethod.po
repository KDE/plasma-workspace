#~ msgstr "Virtuellt tangentbord tillgängligt"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtuellt tangentbord: inaktiverat"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Visa virtuellt tangentbord"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtuellt tangentbord: synligt"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtuellt tangentbord: visa annan inmatning än från musen"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtuellt tangentbord: visa med alla inmatningsmetoder"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtuellt tangentbord: aktiverat"
