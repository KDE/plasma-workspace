msgid "Day light temperature:"
msgstr "Температура на дневни цветове:"

#: ui/main.qml:298 ui/main.qml:364
#, kde-format
msgctxt "Night colour blue-ish; no blue light filter activated"
msgid "Cool (no filter)"
msgstr "Студено (без филтър)"

#: ui/main.qml:305 ui/main.qml:371
#, kde-format
msgctxt "Night colour red-ish"
msgid "Warm"
msgstr "Топло"

