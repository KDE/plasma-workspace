#: ui/DayNightView.qml:154
#, kde-format
msgid ""
"Color temperature begins changing to night time at %1 and is fully changed "
"by %2"
msgstr ""
"Промените към вечерни цветове започват в %1 и са напълно завършени в %2"

#: ui/DayNightView.qml:157
#, kde-format
msgid ""
"Color temperature begins changing to day time at %1 and is fully changed by "
"%2"
msgstr "Промените към дневни цветове започват в %1 и са напълно завършени в %2"

#: ui/main.qml:104
#, kde-format
msgctxt "@info"
msgid "The blue light filter makes the colors on the screen warmer."
msgstr "Филтъра за синя светлина прави цветовете на екрана по-топли."

#: ui/main.qml:117
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily activated until %1."
msgstr "Вечерни цветове е временно активиран до %1."

#: ui/main.qml:119
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily activated until it is manually turned off."
msgstr "Вечерни цветове е временно активиран, докато не бъде изключен ръчно."

#: ui/main.qml:121
#, kde-format
msgctxt "@info Placeholder is for time"
msgid "Night Light is temporarily suspended until %1."
msgstr "Вечерни цветове е временно спрян до %1."

#: ui/main.qml:123
#, kde-format
msgctxt "@info"
msgid "Night Light is temporarily suspended until it is manually resumed."
msgstr "Вечерни цветове е временно спрян до ръчното му възобновяване."

#: ui/main.qml:130
#, kde-format
msgctxt "@action:button turn off Night Light feature"
msgid "Turn Off"
msgstr "Изключване"

#: ui/main.qml:141
#, kde-format
msgctxt ""
"@action:button resume Light Light feature, which had been temporarily "
"disabled"
msgid "Resume"
msgstr "Възобновяване"

#: ui/main.qml:159
#, kde-format
msgctxt "@label:listbox Night Light modes"
msgid "Switching times:"
msgstr "Време за активиране:"

#: ui/main.qml:170
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Always off"
msgstr "Винаги изключено"

#: ui/main.qml:171
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Always on"
msgstr "Винаги включено"

#: ui/main.qml:172
#, kde-format
msgctxt "@item:inlistbox switching times"
msgid "Sunrise and sunset"
msgstr "Изгрев и залез"

#: ui/main.qml:189
#, kde-format
msgctxt "@action:button Configure day-night cycle times"
msgid "Configure…"
msgstr "Конфигуриране…"

#: ui/main.qml:240 ui/main.qml:291 ui/main.qml:357
#, kde-format
msgctxt "Color temperature in Kelvin"
msgid "%1 K"
msgstr "%1 K"

