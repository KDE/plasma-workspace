#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Ekrāna tastatūra"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Izslēgta"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Skārienekrāns un planšetdators"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Skārienekrāns, planšetdators, pele un skārienpaliktnis"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Konfigurēt ekrāna tastatūras…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Ekrāna tastatūra: nav pieejama\n"
"Klikšķiniet vai pieskarieties, lai konfigurētu ekrāna tastatūru."

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Konfigurēt, lai automātiski nerādītu\n"
"Klikšķiniet vai pieskarieties, lai konfigurētu ekrāna tastatūru"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Šobrīd nav atbalstītu teksta lauku\n"
"Klikšķiniet vai pieskarieties, lai parādītu aparatūras tastatūras emulācijas "
"režīmu."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Ekrāna tastatūra ir redzama\n"
"Klikšķiniet vai pieskarieties ekrāna tastatūrai."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Rāda automātiski, pieskaroties teksta laukam\n"
"Pieskarieties, lai konfigurētu ekrāna tastatūru"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Rādīt automātiski, mijiedarbojoties ar teksta lauku\n"
"Klikšķiniet vai pieskarieties, lai konfigurētu ekrāna tastatūru"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Virtuālā tastatūra: nav pieejama"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Virtuālā tastatūra: izslēgta"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Parādīt virtuālo tastatūru"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Virtuālā tastatūra: redzama"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Virtuālā tastatūra: rādīt pie ievades, kas nav peles ievade"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Virtuālā tastatūra: rādīt ar visām ievades ierīcēm"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Virtuālā tastatūra: ieslēgta"
