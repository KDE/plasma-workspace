#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Näyttönäppäimistö"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Ei käytössä"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Kosketus ja tabletti"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Kosketus, tabletti, hiiri ja kosketuslevy"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Näyttönäppäimistön asetukset…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Näyttönäppäimistö: ei käytettävissä\n"
"Aseta näyttönäppäimistön asetukset napsauttamalla tai napauttamalla"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Asetettu olemaan näkymättä automaattisesti\n"
"Aseta näyttönäppäimistön asetukset napsauttamalla tai napauttamalla"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Aktiivisena on ei-tuettu tekstikenttä\n"
"Näytä laitenäppäimistön emulointitila napsauttamalla tai napauttamalla."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Näyttönäppäimistö on näkyvissä\n"
"Piilota näyttönäppäimistö napsauttamalla tai napauttamalla"

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Näyttää automaattisesti napautettaessa tekstikenttää\n"
"Aseta näyttönäppäimistön asetukset napsauttamalla tai napauttamalla"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Näyttää automaattisesti käytettäessä tekstikenttää\n"
"Aseta näyttönäppäimistön asetukset napsauttamalla tai napauttamalla"

