#: ui/main.qml:28
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr "用户反馈已被集中禁用。请联系您的软件发行组织。"

#: ui/main.qml:33
#, kde-format
msgid "Plasma"
msgstr "Plasma"

#: ui/main.qml:45
#, kde-format
msgctxt "@info"
msgid ""
"Help KDE improve Plasma by sending system and usage information. This is "
"optional and entirely anonymous—we never collect your personal data, files "
"you use, websites you visit, or information that could identify you."
msgstr ""
"通过发送系统和使用信息帮助 KDE 改进 Plasma。此功能为可选项，且完全匿名——我们"
"不会收集您的个人数据、使用的文件、访问的网站，或任何可能识别您身份的信息。"

#: ui/main.qml:54
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "了解我们的隐私政策"

#: ui/main.qml:64
#, kde-format
msgid "Plasma:"
msgstr "Plasma："

#: ui/main.qml:117
#, kde-format
msgid "The following information will be sent:"
msgstr "将发送以下信息："

