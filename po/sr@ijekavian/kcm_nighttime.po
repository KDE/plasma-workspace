msgstr "Излазак сунца почиње у %1 и завршава се у %2"

#: ui/SunPath.qml:57
#, kde-format
msgctxt "@label"
msgid "Sunrise"
msgstr "Излазак сунца"

#: ui/SunPath.qml:77
#, kde-format
msgctxt "@info:tooltip; the variables are times of day, e.g. 07:30"
msgid "Sunset starts at %1 and ends at %2"
msgstr "Залазак сунца почиње у %1 и завршава се у %2"

