#: ui/ComponentOverlay.qml:98
#, kde-format
msgctxt "@label %1 is a MIME type and %2 is an application name"
msgid "%1 (Currently opens in %2)"
msgstr "%1 (тренутно се отвара у програму %2)"

#: ui/ComponentOverlay.qml:111
#, kde-format
msgctxt "@action:button %1 is an application name"
msgid "Open All in %1"
msgstr "Отвори све у програму %1"

#: ui/ComponentOverlay.qml:130
#, kde-format
msgid ""
"This application does not advertise support for the following file types, "
"but may be able to open them anyway:"
msgstr ""
"Овај програм не наводи подршку за сљедеће типове фајлова, али можда ипак "
"може да их отвори:"

