#: gtkpage.cpp:57
#, kde-format
msgid "%1 is not a valid GTK Theme archive."
msgstr "%1 није исправна архива ГТК теме."

#: kcmstyle.cpp:117
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: Cannot install a style from a remote location."
msgstr "Инсталирање пропало: не могу да инсталирам стил са удаљене локације."

#: kcmstyle.cpp:123
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be read."
msgstr "Инсталирање пропало: не могу да прочитам фајл стила."

#: kcmstyle.cpp:128
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file does not contain any data."
msgstr "Инсталирање пропало: фајл стила не садржи никакве податке."

#: kcmstyle.cpp:134
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style file could not be unpacked."
msgstr "Инсталирање пропало: не могу да распакујем фајл стила."

#: kcmstyle.cpp:144
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The style could not be found."
msgstr "Инсталирање пропало: не могу да нађем стил."

#: kcmstyle.cpp:148
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected file is not a valid Union style."
msgstr "Инсталирање пропало: изабрани фајл није исправан стил Union."

#: kcmstyle.cpp:151
#, kde-format
msgctxt "@info:status"
msgid "Installation failed: The selected style is not supported."
msgstr "Инсталирање пропало: изабрани стил није подржан."

#: kcmstyle.cpp:165
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: The style is already installed."
msgstr "Инсталирање „%1“ пропало: стил је већ инсталиран."

#: kcmstyle.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: Permission was denied."
msgstr "Инсталирање „%1“ пропало: дозвола одбијена."

#: kcmstyle.cpp:174
#, kde-format
msgctxt "@info:status"
msgid "Installing “%1” failed: %2"
msgstr "Инсталирање „%1“ пропало: %2"

#: kcmstyle.cpp:179
#, kde-format
msgctxt "@info:status"
msgid "Successfully installed “%1”."
msgstr "Успјешно инсталиран „%1“."

#: kcmstyle.cpp:192
#, kde-format
msgctxt "@info:status"
msgid "Uninstall failed: The style with ID “%1” could not be found."
msgstr "Деинсталирање пропало: не могу да нађем стил са ИД‑ом „%1“."

#: kcmstyle.cpp:202
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: Permission was denied."
msgstr "Деинсталирање „%1“ пропало: дозвола одбијена."

#: kcmstyle.cpp:204
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is not installed."
msgstr "Деинсталирање „%1“ пропало: стил није инсталиран."

#: kcmstyle.cpp:206
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: The style is in use."
msgstr "Деинсталирање „%1“ пропало: стил је у употреби."

#: kcmstyle.cpp:208
#, kde-format
msgctxt "@info:status"
msgid "Uninstalling “%1” failed: %2"
msgstr "Деинсталирање „%1“ пропало: %2"

#: kcmstyle.cpp:223
#, kde-format
msgctxt "@info:status"
msgid "Could not uninstall styles:\n"
msgstr "Не могу да деинсталирам стилове:\n"

#: kcmstyle.cpp:226
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1” but could not uninstall others:\n"
msgstr "Успјешно деинсталиран „%1“, али не могу да деинсталирам остале:\n"

#: kcmstyle.cpp:229
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style but could not uninstall others:\n"
msgid_plural ""
"Successfully uninstalled %1 styles but could not uninstall others:\n"
msgstr[0] ""
"Успјешно деинсталиран %1 стил, али не могу да деинсталирам остале:\n"
msgstr[1] ""
"Успјешно деинсталирана %1 стила, али не могу да деинсталирам остале:\n"
msgstr[2] ""
"Успјешно деинсталирано %1 стилова, али не могу да деинсталирам остале:\n"
msgstr[3] ""
"Успјешно деинсталиран један стил, али не могу да деинсталирам остале:\n"

#: kcmstyle.cpp:240
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled “%1”."
msgstr "Успјешно деинсталиран „%1“."

#: kcmstyle.cpp:242
#, kde-format
msgctxt "@info:status"
msgid "Successfully uninstalled %1 style"
msgid_plural "Successfully uninstalled %1 styles."
msgstr[0] "Успјешно деинсталиран %1 стил."
msgstr[1] "Успјешно деинсталирана %1 стила."
msgstr[2] "Успјешно деинсталирано %1 стилова."
msgstr[3] "Успјешно деинсталиран један стил"

#: kcmstyle.cpp:306 kcmstyle.cpp:313
#, kde-format
msgid "There was an error loading the configuration dialog for this style."
msgstr "Грешка при учитавању дијалога за подешавање овог стила."

