#: ui/main.qml:28
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr ""
"O feedback do usuário foi desativado globalmente. Contate o seu distribuidor."

#: ui/main.qml:33
#, kde-format
msgid "Plasma"
msgstr "Plasma"

#: ui/main.qml:45
#, kde-format
msgctxt "@info"
msgid ""
"Help KDE improve Plasma by sending system and usage information. This is "
"optional and entirely anonymous—we never collect your personal data, files "
"you use, websites you visit, or information that could identify you."
msgstr ""
"Ajude o KDE a aprimorar o Plasma enviando informações sobre o sistema e o "
"uso. Isso é opcional e totalmente anônimo — nunca coletamos seus dados "
"pessoais, os arquivos que você utiliza, os sites que você visita ou qualquer "
"informação que possa identificá-lo."

#: ui/main.qml:54
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "Leia mais sobre nossa política de privacidade"

#: ui/main.qml:64
#, kde-format
msgid "Plasma:"
msgstr "Plasma:"

#: ui/main.qml:117
#, kde-format
msgid "The following information will be sent:"
msgstr "Será enviada a seguinte informação:"

#: ui/main.qml:141
#, kde-format
