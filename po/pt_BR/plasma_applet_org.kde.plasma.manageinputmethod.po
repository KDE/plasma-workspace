#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Teclado na tela"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Desabilitado"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Tela sensível ao toque e tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Tela sensível ao toque, tablet, mouse e touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Configurar teclados na tela..."

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Teclado na tela: indisponível\n"
"Clique ou toque para definir as configurações do teclado na tela"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Configurado para não aparecer automaticamente\n"
"Clique ou toque para definir as configurações do teclado na tela"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Nenhum campo de texto compatível está ativo no momento\n"
"Clique ou toque para exibir no modo de emulação de teclado físico."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"O teclado na tela está visível\n"
"Clique ou toque para ocultar o teclado na tela."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Exibido automaticamente ao tocar em um campo de texto\n"
"Toque para configurar as configurações do teclado na tela"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Exibido automaticamente ao interagir com um campo de texto\n"
"Clique ou toque para definir as configurações do teclado na tela"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Teclado virtual: não disponível"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Teclado virtual: desabilitado"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Mostrar teclado virtual"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Teclado virtual: visível"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Teclado virtual: Mostrar em entrada sem mouse"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Teclado virtual: Mostrar com todos os dispositivos de entrada"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Teclado virtual: habilitado"
