msgid "Show action popup menu:"
msgstr "قاڭقىش مەشغۇلات تىزىملىكىنى كۆرسىتىدۇ:"

#: configdialog.cpp:180
#, kde-kuit-format
msgctxt "@info"
msgid ""
"When text that matches an action pattern is selected or is chosen from the "
"clipboard history, automatically show the popup menu with applicable "
"actions. If the automatic menu is turned off here, or it is not shown for an "
"excluded window, then it can be shown by using the <shortcut>%1</shortcut> "
"key shortcut."
msgstr ""
"تاللانغان تېكىست ياكى چاپلاش تاختىسىدىكى تارىخ خاتىرىسى تېكىستى بىر مەشغۇلات "
"ھالىتىگە ماس كەلگەندە، قاڭقىش تىزىملىكىدە قوللىنىدىغان مەشغۇلات ئۆزلۈكىدىن "
"كۆرۈنىدۇ. ئەگەر بۇ جايدىكى ئاپتوماتىك تىزىملىك  تاقالسا ياكى مۇستەسنا كۆزنەك "
"تۈپەيلىدىن كۆرۈنمىسە، بۇ مەشغۇلاتنى <shortcut>%1</shortcut> تېزلەتمە "
"ئارقىلىق كۆرسەتكىلى بولىدۇ."

