#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "ئېكران ھەرپتاختىسى"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "چەكلەنگەن"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "تەگكۈز ۋە تاختا كومپيۇتېر"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "تەگكۈز، تاختا كومپيۇتېر، چاشقىنەك ۋە سەزگۈر تاختا"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "ئېكران ھەرپتاختا سەپلە…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"ئېكران ھەرپتاختا: ئىشلەتكىلى بولمايدۇ\n"
"چېكىپ ياكى تەگكۈزۈلسە ئېكران ھەرپتاختا تەڭشىكىنى سەپلەيدۇ"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"سەپلىمە ئۆزلۈكىدىن كۆرسىتىلمەيدۇ\n"
"چېكىپ ياكى تەگكۈزۈلسە ئېكران ھەرپتاختا تەڭشىكىنى سەپلەيدۇ"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"نۆۋەتتە ھېچقانداق قوللايدىغان تېكىست بۆلىكى ئاكتىپ ئەمەس\n"
"چېكىپ ياكى تەگكۈزۈلسە قاتتىق دېتال ھەرپتاختا تەقلىدلىگۈچ ھالىتىنى كۆرسىتىدۇ."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"ئېكران ھەرپتاختىنى كۆرگىلى بولىدۇ\n"
"چېكىپ ياكى تەگكۈزۈلسە ئېكران ھەرپتاختا يوشۇرۇلىدۇ."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"تېكىست بۆلىكى چېكىلگەندە ئۆزلۈكىدىن كۆرسىتىدۇ\n"
"چېكىلسە ئېكران ھەرپتاختا تەڭشىكىنى سەپلەيدۇ"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"تېكىست بۆلىكى بىلەن تەسىرلەشكەندە ئۆزلۈكىدىن كۆرسىتىدۇ\n"
"چېكىلسە ئېكران ھەرپتاختا تەڭشىكىنى سەپلەيدۇ"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "مەۋھۇم ھەرپتاختا: ئىشلەتكىلى بولمايدۇ"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "مەۋھۇم ھەرپتاختا: چەكلەنگەن"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "مەۋھۇم ھەرپتاختىنى كۆرسەت"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "مەۋھۇم ھەرپتاختا: كۆرۈنۈشچان"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "مەۋھۇم ھەرپتاختا: چاشقىنەك كىرگۈزۈشى بايقالمىسا كۆرسەت"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "مەۋھۇم ھەرپتاختا: بارلىق كىرگۈزۈش ئۈسكۈنىسى بىلەن بىللە كۆرسەت"
