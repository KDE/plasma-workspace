#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Klawiatura ekranowa"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Wyłączone"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dotyk i tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dotyk, Tablet, Mysz oraz Gładzik"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Ustawienia klawiatur ekranowych…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Klawiatura ekranowa jest niedostępna\n"
"Kliknij lub stuknij, aby dostosować jej ustawienia"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Ustawiona, aby nie pokazywać się samoczynnie\n"
"Kliknij lub stuknij, aby dostosować jej ustawienia"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Obecnie nie skupiono uwagi na żadnym obsługiwanym polu tekstowym\n"
"Kliknij lub stuknij, aby pokazać tryb emulacji klawiatury sprzętowej."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Klawiatura ekranowa jest widoczna\n"
"Kliknij lub stuknij, aby ją ukryć."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Sama się pokaże po stuknięciu na pole tekstowe\n"
"Stuknij, aby nadać ustawienia klawiaturze ekranowej"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Sama się pokaże po skupieniu uwagi na polu tekstowym\n"
"Kliknij lub stuknij, aby nadać ustawienia klawiaturze ekranowej"

#~ msgid "Virtual Keyboard: unavailable"
#~ msgstr "Klawiatura ekranowa: niedostępna"

#~ msgid "Virtual Keyboard: disabled"
#~ msgstr "Klawiatura ekranowa: wyłączona"

#~ msgid "Show Virtual Keyboard"
#~ msgstr "Pokaż klawiaturę ekranową"

#~ msgid "Virtual Keyboard: visible"
#~ msgstr "Klawiatura ekranowa: widoczna"

#~ msgid "Virtual Keyboard: Show on non-mouse input"
#~ msgstr "Klawiatura ekranowa: Pokaż przy obsłudze bez myszy"

#~ msgid "Virtual Keyboard: Show with all input devices"
#~ msgstr "Klawiatura ekranowa: Pokaż przy obsłudze wszystkimi urządzeniami"

#~ msgid "Virtual Keyboard: enabled"
#~ msgstr "Klawiatura ekranowa: włączona"
